---
import audit from '../data/model-audit.json';
import {pick,type Locale} from '../i18n';
import {path} from '../lib/site';
const {lang}=Astro.props as {lang:Locale};const p=(pt:string,en:string)=>pick(lang,pt,en);
const labels:Record<string,string>={implemented:p('Implementado','Implemented'),adapted:p('Adaptado','Adapted'),example:p('Exemplo no design system','Design system example')};
const localized=(route:string)=>lang==='pt'?route:({'design-system/':'en/design-system/','publicacoes/':'en/publications/','publicacoes/modelo/':'en/publications/template/','publicacoes/editor/':'en/publications/editor/','':'en/'} as Record<string,string>)[route]||route;
const href=(row:typeof audit.patterns[number])=>path(localized(row.route))+((row.selector.match(/^#[\w-]+/)||[])[0]||'');
const count=(status:string)=>audit.patterns.filter(row=>row.status===status).length;
---
<aside class="ds-model-audit ds-lab-panel" id="model-audit" aria-labelledby="model-audit-title"><span class="eyebrow">{p('RASTREABILIDADE DOS MODELOS','REFERENCE TRACEABILITY')}</span><h2 id="model-audit-title">{p('Correspondência com os arquivos de referência','Reference file coverage')}</h2><p>{p('Inventário dos seis ZIPs e do texto colado: 11 arquivos HTML nos ZIPs, nove modelos HTML distintos e três páginas no texto. Cada registro abaixo aponta para uma implementação, adaptação ou exemplo disponível.','Inventory of the six ZIP files and pasted text: 11 HTML files in the archives, nine distinct HTML models and three pages in the text. Each record below points to an implementation, adaptation or available example.')}</p><div class="ds-audit-counts">{['implemented','adapted','example'].map(status=><div><strong>{count(status)}</strong><span>{labels[status]}</span></div>)}</div><p>{p('A contagem representa registros de correspondência, não componentes únicos. Adaptado significa que conteúdo, dados, marca, formato ou operação diferem do protótipo; exemplo significa que o padrão existe na documentação, sem serviço ou afirmação institucional ativa.','Counts represent coverage records, not unique components. Adapted means content, data, branding, format or operation differs from the prototype; example means the pattern exists in the documentation without an active service or institutional claim.')}</p><details class="ds-audit-details"><summary>{p('Ver matriz completa de correspondência','View the full coverage matrix')} ({audit.patterns.length})</summary><div class="ds-table-wrap"><table><caption>{p('Padrões dos modelos e destinos verificáveis','Reference patterns and verifiable destinations')}</caption><thead><tr><th scope="col">{p('Elemento no modelo','Reference element')}</th><th scope="col">{p('Situação','Status')}</th><th scope="col">{p('Onde encontrar','Where to find it')}</th></tr></thead><tbody>{audit.patterns.map(row=><tr><th scope="row">{row.heading}<small>{row.source}</small></th><td>{labels[row.status]}</td><td><a class="text-link" href={href(row)}>{p('Ver elemento','View element')}</a><code>{row.selector||row.route}</code></td></tr>)}</tbody></table></div></details><details class="ds-audit-details"><summary>{p('Adaptações e limites da implementação','Adaptations and implementation limits')}</summary><ul class="ds-list"><li>{p('Equipe, parceiros, depoimentos, métricas e newsletter: modelos editáveis, sem pessoas, vínculos ou resultados presumidos.','Team, partners, testimonials, metrics and newsletter: editable examples without assumed people, relationships or results.')}</li><li>{p('Selos, certificações, credenciais profissionais, DOI, citações e medições fictícias não são apresentados como fatos.','Badges, certifications, professional credentials, DOIs, citations and fictional measurements are not presented as facts.')}</li><li>{p('Contato por e-mail. Newsletter automática, upload ao servidor e integrações externas não estão ativos.','Email contact. Automatic newsletter signup, server uploads and external integrations are not active.')}</li><li>{p('Papelaria em sRGB, sem PDF/X, perfil ICC ou faca industrial. Fotografias foram reinterpretadas como mockups locais.','Stationery uses sRGB without PDF/X, an ICC profile or an industrial die. Photographs were reinterpreted as local mockups.')}</li></ul></details><a class="text-link" href={path('design/model-audit.json').replace(/\/$/,'')} download>{p('Baixar inventário e matriz JSON','Download inventory and JSON matrix')}</a></aside>
