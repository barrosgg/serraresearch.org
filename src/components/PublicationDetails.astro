---
import {pick,type Locale} from '../i18n';
import {resourceHref,type PublicationData} from '../lib/publication-metadata';
import {northeast} from '../lib/visuals';
const {data:d}=Astro.props as {data:PublicationData};
const lang=d.language as Locale;const p=(pt:string,en:string)=>pick(lang,pt,en);
const statuses={'working-paper':p('Documento de trabalho','Working paper'),preprint:'Preprint',accepted:p('Aceito','Accepted'),published:p('Publicado','Published')};
const reviews={'not-peer-reviewed':p('Sem revisão por pares','Not peer reviewed'),'editorial-review':p('Revisão editorial','Editorial review'),'peer-reviewed':p('Revisado por pares','Peer reviewed')};
const external={target:'_blank',rel:'noopener noreferrer'};
const optionalFields=[[p('Veículo ou evento','Venue or event'),p('Nome, tipo, link, volume, número e páginas, quando aplicáveis.','Name, type, link, volume, issue and pages, where applicable.')],[p('Autoria e afiliação','Authorship and affiliations'),p('Nome, instituições na época da publicação, perfil e ORCID.','Name, institutions at publication time, profile and ORCID.')],[p('Estado e revisão','Status and review'),p('Documento de trabalho, preprint, aceito ou publicado; revisão declarada separadamente.','Working paper, preprint, accepted or published; review declared separately.')],[p('Identificação e versão','Identification and version'),p('DOI, número de relatório, versão e URL da publicação original.','DOI, report number, version and original publication URL.')],[p('Recursos e reprodução','Resources and reproduction'),p('PDF, código, dados, suplementos, slides, vídeo e projeto.','PDF, code, data, supplements, slides, video and project.')],[p('Transparência científica','Scientific transparency'),p('Licença, financiamento, conflitos, ética e disponibilidade dos dados.','License, funding, conflicts, ethics and data availability.')]];
---
<section class="publication-details" id="publication-details" aria-labelledby="publication-details-title"><span class="eyebrow">{p('FICHA DA PUBLICAÇÃO','PUBLICATION DETAILS')}</span><h2 id="publication-details-title">{p('Autoria e contexto editorial','Authors and publication context')}</h2>
 <div class="publication-authors">{d.authors.map(author=><div><h3>{author.url?<a href={author.url} {...external}>{author.name}<Fragment set:html={northeast}/></a>:author.name}</h3>{author.affiliations.length>0&&<p>{author.affiliations.join(' · ')}</p>}{'orcid' in author&&author.orcid&&<a class="author-orcid" href={`https://orcid.org/${author.orcid}`} {...external}>ORCID: {author.orcid}<Fragment set:html={northeast}/></a>}</div>)}</div>
 {d.authors.some(a=>a.affiliations.length)&&<p class="publication-affiliation-note">{p('Afiliações informadas na época da publicação.','Affiliations as reported at the time of publication.')}</p>}
 {(d.publisher||d.venue||d.publicationStatus||d.reviewStatus||d.version||d.reportNumber||d.license)&&<dl class="publication-facts">{d.publisher&&<div><dt>{p('Editora / instituição','Publisher / institution')}</dt><dd>{d.publisher}</dd></div>}{d.venue&&<div><dt>{p('Publicação / veículo','Publication / venue')}</dt><dd>{d.venue.url?<a href={d.venue.url} {...external}>{d.venue.name}<Fragment set:html={northeast}/></a>:d.venue.name}{(d.venue.volume||d.venue.issue||d.venue.pages)&&<span>{[d.venue.volume&&`Vol. ${d.venue.volume}`,d.venue.issue&&`${p('Nº','Issue')} ${d.venue.issue}`,d.venue.pages&&`pp. ${d.venue.pages}`].filter(Boolean).join(' · ')}</span>}</dd></div>}{d.publicationStatus&&<div><dt>{p('Estado','Status')}</dt><dd>{statuses[d.publicationStatus]}</dd></div>}{d.reviewStatus&&<div><dt>{p('Revisão','Review')}</dt><dd>{reviews[d.reviewStatus]}</dd></div>}{d.version&&<div><dt>{p('Versão','Version')}</dt><dd>{d.version}</dd></div>}{d.reportNumber&&<div><dt>{p('Nº do relatório','Report number')}</dt><dd>{d.reportNumber}</dd></div>}{d.license&&<div><dt>{p('Licença','License')}</dt><dd>{d.license.url?<a href={d.license.url} {...external}>{d.license.name}<Fragment set:html={northeast}/></a>:d.license.name}</dd></div>}</dl>}
 {d.draft&&<details class="publication-editorial-guide" open><summary>{p('Campos disponíveis neste template','Available fields in this template')}</summary><p>{p('Preencha os campos aplicáveis no Markdown. Os campos opcionais só aparecem na ficha quando informados; nomes e identificadores demonstrativos não devem ser publicados como dados reais.','Fill in applicable Markdown fields. Optional fields appear only when supplied; demonstration names and identifiers must not be published as real data.')}</p><dl>{optionalFields.map(([title,description])=><div><dt>{title}</dt><dd>{description}</dd></div>)}</dl></details>}
 </section>
 {(d.pdf||d.publicationUrl||d.resources.length>0)&&<section class="publication-resources" id="resources" aria-labelledby="resources-title"><span class="eyebrow">{p('MATERIAIS DA PESQUISA','RESEARCH MATERIALS')}</span><h2 id="resources-title">{p('Recursos e reprodução','Resources and reproduction')}</h2><div class="publication-resource-links">{d.pdf&&<a class="button button-small" href={resourceHref(d.pdf)}>{p('Abrir PDF','Open PDF')}<Fragment set:html={northeast}/></a>}{d.publicationUrl&&<a class="text-link" href={d.publicationUrl} {...external}>{p('Publicação original','Original publication')}<Fragment set:html={northeast}/></a>}{d.resources.map(resource=><a class="text-link" href={resourceHref(resource.url)} {...external}><span class="mono">{resource.kind.toUpperCase()}</span>{resource.label}<Fragment set:html={northeast}/></a>)}</div></section>}
 {(d.funding.length||d.conflicts||d.ethics||d.dataAvailability)&&<section class="publication-transparency" id="research-transparency" aria-labelledby="research-transparency-title"><h2 id="research-transparency-title">{p('Transparência da pesquisa','Research transparency')}</h2><dl class="publication-facts">{d.funding.length>0&&<div><dt>{p('Financiamento','Funding')}</dt><dd>{d.funding.join(' · ')}</dd></div>}{d.conflicts&&<div><dt>{p('Conflitos de interesse','Conflicts of interest')}</dt><dd>{d.conflicts}</dd></div>}{d.ethics&&<div><dt>{p('Ética e proteção de participantes','Ethics and participant protection')}</dt><dd>{d.ethics}</dd></div>}{d.dataAvailability&&<div><dt>{p('Disponibilidade dos dados','Data availability')}</dt><dd>{d.dataAvailability}</dd></div>}</dl></section>}
