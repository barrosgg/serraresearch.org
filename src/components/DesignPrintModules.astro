---
import {pick,type Locale} from '../i18n';
import {path,email} from '../lib/site';
import {arrow} from '../lib/visuals';
const {lang}=Astro.props as {lang:Locale};const p=(pt:string,en:string)=>pick(lang,pt,en);
const asset=(name:string)=>path(`design/print/${name}`).replace(/\/$/,'');
const modules=[['timbrado',p('Timbrado A4','A4 letterhead')],['cartoes',p('Cartões','Business cards')],['envelopes',p('Envelopes','Envelopes')],['dossies',p('Dossiê e pasta','Dossier and folder')],['credenciais',p('Credenciais de campo','Field badges')],['conversao',p('Conversão de cores','Color conversion')],['pre-impressao',p('Kit de produção','Production kit')]];
const colors=[['Coral / Precision Orange','#fd5638',p('Ponto da marca e capas','Brand dot and covers')],['Grafite / Charcoal','#2e2e2e',p('Títulos e hierarquia','Headings and hierarchy')],['Texto / Body','#494a4d',p('Corpo do documento','Document text')],['Neve / Snow','#f4f5f8',p('Fundos e áreas de apoio','Backgrounds and supporting areas')],['Azul / Data Blue','#0057ff',p('Dados e links','Data and links')]];
const convert=(hex:string)=>{const rgb=hex.slice(1).match(/../g)!.map(v=>parseInt(v,16));const cmy=rgb.map(v=>1-v/255);const k=Math.min(...cmy);return {rgb:rgb.join(', '),cmyk:[...cmy.map(v=>k===1?0:(v-k)/(1-k)),k].map(v=>Math.round(v*100)).join(' / ')};};
---
<nav class="ds-print-toc" aria-label={p('Seções de papelaria','Stationery sections')}>{modules.map(([id,label],i)=><a href={`#print-${id}`}><span class="mono">{String(i+1).padStart(2,'0')}</span>{label}</a>)}</nav>
<section id="print-timbrado" class="ds-print-detail" aria-labelledby="print-letter-title"><div class="ds-print-heading"><span class="eyebrow">01 / {p('SUPORTE DOCUMENTAL','DOCUMENT SUPPORT')}</span><h3 id="print-letter-title">{p('Papel timbrado A4 e documentos técnicos','A4 letterhead and technical documents')}</h3><span class="ds-spec-label mono">210 × 297 MM</span></div><div class="ds-print-detail-grid"><div class="ds-paper-preview"><div class="wordmark">Serra <span>Research</span><i></i></div><div class="ds-paper-meta mono">{p('RELATÓRIO TÉCNICO / MODELO','TECHNICAL REPORT / TEMPLATE')}<br/>DATE / VERSION / AUTHORS</div><div class="ds-paper-title">{p('Evidências para orientar decisões.','Evidence to inform decisions.')}</div><p>{p('Contexto, metodologia, resultados, limitações e fontes. Uma estrutura de leitura para comunicar pesquisas com responsabilidade.','Context, methods, results, limitations and sources. A reading structure for communicating research responsibly.')}</p><div class="ds-paper-placeholder" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><div class="ds-paper-sign"><strong>{p('Autoria e responsabilidade técnica','Authorship and technical responsibility')}</strong><p>{p('Preencher com os dados verificados do documento.','Complete with the document’s verified information.')}</p></div><div class="ds-paper-contact mono">{email}<br/>{p('MODELO EDITÁVEL · SEM ASSINATURA OU CERTIFICAÇÃO','EDITABLE TEMPLATE · NO SIGNATURE OR CERTIFICATION')}</div></div><div class="ds-print-notes"><article class="ds-lab-card"><span class="eyebrow">{p('MATERIAIS E FORMATO','MATERIALS AND FORMAT')}</span><h4>{p('Substrato e fibras','Substrate and fibers')}</h4><p>{p('Papel branco ou natural de 90 a 120 g/m², como ponto de partida para orçamento. Avaliar legibilidade, impressão frente e verso e evidência de origem das fibras com o fornecedor.','White or natural 90–120 g/m² paper as a starting point for a quote. Review legibility, duplex printing and evidence of fiber sourcing with the supplier.')}</p><dl><div><dt>{p('Margens','Margins')}</dt><dd>24 mm</dd></div><div><dt>{p('Sangria, se houver fundo até a borda','Bleed, when backgrounds reach the edge')}</dt><dd>3 mm</dd></div></dl></article><article class="ds-lab-card"><span class="eyebrow">{p('IMPRESSÃO','PRINTING')}</span><h4>{p('Offset e cores especiais','Offset and spot colors')}</h4><p>{p('O arquivo de demonstração usa sRGB. Conversão para CMYK e eventual cor especial dependem do papel, processo, perfil ICC e prova aprovada com a gráfica.','The demonstration file uses sRGB. CMYK conversion and any spot color depend on the paper, process, ICC profile and a proof approved with the printer.')}</p><a class="text-link" href={asset('letterhead.svg')} download>{p('Baixar vetor A4','Download A4 vector')}<Fragment set:html={arrow}/></a></article></div></div></section>
<section id="print-cartoes" class="ds-print-detail" aria-labelledby="print-cards-title"><div class="ds-print-heading"><span class="eyebrow">02 / {p('IDENTIDADE INSTITUCIONAL','INSTITUTIONAL IDENTITY')}</span><h3 id="print-cards-title">{p('Cartões de visita: frente e verso','Business cards: front and back')}</h3><span class="ds-spec-label mono">85 × 55 MM</span></div><div class="ds-business-pair"><div class="ds-business-front"><span class="mono">{p('FRENTE / CONTATO','FRONT / CONTACT')}</span><div class="wordmark">Serra <span>Research</span><i></i></div><strong>{p('Pesquisa e engenharia de dados','Research and data engineering')}</strong><p>{email}</p><span class="mono">SÃO PAULO / BRASIL</span></div><div class="ds-business-back"><span class="mono">{p('VERSO / PESQUISA','BACK / RESEARCH')}</span><h4>{p('Inteligência para impacto social.','Intelligence for social impact.')}</h4><p>{p('Pesquisa aplicada, dados e tecnologias para decisões com evidências.','Applied research, data and technologies for evidence-informed decisions.')}</p><span class="mono">SERRARESEARCH.ORG</span></div></div><div class="ds-lab-panel ds-print-tip"><h4>{p('Materiais e verificabilidade','Materials and verifiability')}</h4><p>{p('Avaliar papel de 300 a 350 g/m² e acabamento fosco. Nome, função, ORCID e links de repositórios devem corresponder a pessoas e registros reais. QR codes, quando usados, devem apontar para um destino verificado.','Consider 300–350 g/m² paper and a matte finish. Names, roles, ORCIDs and repository links must correspond to real people and records. QR codes, when used, must point to a verified destination.')}</p><div class="ds-print-downloads"><a class="text-link" href={asset('business-card-front.svg')} download>{p('Baixar frente','Download front')}<Fragment set:html={arrow}/></a><a class="text-link" href={asset('business-card-back.svg')} download>{p('Baixar verso','Download back')}<Fragment set:html={arrow}/></a></div></div></section>
<section id="print-envelopes" class="ds-print-detail" aria-labelledby="print-envelopes-title"><div class="ds-print-heading"><span class="eyebrow">03 / {p('CORRESPONDÊNCIA E REMESSA','CORRESPONDENCE AND DELIVERY')}</span><h3 id="print-envelopes-title">{p('Envelopes DL e C4','DL and C4 envelopes')}</h3><span class="ds-spec-label mono">110 × 220 / 229 × 324 MM</span></div><div class="ds-two"><article class="ds-lab-card"><div class="ds-envelope dl"><div class="ds-envelope-lining" aria-hidden="true"></div><div class="wordmark">Serra <span>Research</span><i></i></div><div class="ds-envelope-address"><span class="mono">{p('DESTINATÁRIO','RECIPIENT')}</span><p>{p('[Nome / instituição]','[Name / institution]')}<br/>{p('[Endereço / cidade / CEP]','[Address / city / postal code]')}</p></div><span class="mono">{email}</span></div><h4>DL / 220 × 110 mm</h4><p>{p('Para documentos A4 dobrados em três partes. Preservar área livre para destinatário, selo e leitura postal.','For A4 documents folded into thirds. Preserve clear space for recipient details, stamps and postal scanning.')}</p><a class="text-link" href={asset('envelope-dl.svg')} download>{p('Baixar modelo DL','Download DL template')}<Fragment set:html={arrow}/></a></article><article class="ds-lab-card"><div class="ds-envelope c4"><div class="wordmark">Serra <span>Research</span><i></i></div><div class="ds-envelope-address"><span class="mono">{p('DOCUMENTOS DE PESQUISA','RESEARCH DOCUMENTS')}</span><p>{p('Não dobrar','Do not fold')}<br/>{p('[Destinatário]','[Recipient]')}</p></div></div><h4>C4 / 229 × 324 mm</h4><p>{p('Para transporte de documentos A4 sem dobras. Definir gramatura, fechamento e capacidade conforme volume e modalidade de envio.','For transporting A4 documents without folding. Define paper weight, closure and capacity according to volume and delivery method.')}</p><a class="text-link" href={asset('envelope-c4.svg')} download>{p('Baixar modelo C4','Download C4 template')}<Fragment set:html={arrow}/></a></article></div></section>
<section id="print-dossies" class="ds-print-detail" aria-labelledby="print-dossier-title"><div class="ds-print-heading"><span class="eyebrow">04 / {p('APRESENTAÇÃO E GUARDA','PRESENTATION AND STORAGE')}</span><h3 id="print-dossier-title">{p('Dossiê rígido e caixa clamshell','Rigid dossier and clamshell box')}</h3><span class="ds-spec-label mono">A4 / {p('APLICAÇÃO CONCEITUAL','CONCEPTUAL APPLICATION')}</span></div><div class="ds-print-detail-grid"><div class="ds-dossier-scene"><div class="ds-dossier-box"><div class="wordmark">Serra <span>Research</span><i></i></div><h4>{p('Caderno de evidências','Evidence notebook')}</h4><span class="mono">{p('PESQUISA / DADOS / IMPACTO','RESEARCH / DATA / IMPACT')}</span></div><div class="ds-dossier-shadow" aria-hidden="true"></div></div><div class="ds-lab-card"><h4>{p('Pasta de entrega e caixa de arquivo','Delivery folder and archive box')}</h4><dl class="ds-dossier-notes"><div><dt>{p('Pasta interna','Internal folder')}</dt><dd>{p('Bolso e lombada definidos pela espessura dos documentos. Inserção e retirada sem danificar as páginas.','Pocket and spine defined by document thickness. Insertion and removal without damaging pages.')}</dd></div><div><dt>{p('Fechamento','Closure')}</dt><dd>{p('Fecho magnético ou mecânico como opção de projeto, sujeito à prototipagem.','Magnetic or mechanical closure as a design option, subject to prototyping.')}</dd></div><div><dt>{p('Baixo-relevo','Debossing')}</dt><dd>{p('Aplicação da marca com prova física. Temperatura, pressão e matriz devem ser especificadas pelo fornecedor.','Brand application with a physical proof. Temperature, pressure and die must be specified by the supplier.')}</dd></div></dl><a class="text-link" href={asset('dossier-cover.svg')} download>{p('Baixar arte conceitual da capa','Download conceptual cover artwork')}<Fragment set:html={arrow}/></a></div></div></section>
<section id="print-credenciais" class="ds-print-detail" aria-labelledby="print-badges-title"><div class="ds-print-heading"><span class="eyebrow">05 / {p('IDENTIFICAÇÃO EM CAMPO','FIELD IDENTIFICATION')}</span><h3 id="print-badges-title">{p('Credenciais de campo e cartões de acesso','Field badges and access cards')}</h3><span class="ds-spec-label mono">85.60 × 53.98 MM / ID-1</span></div><div class="ds-badge-layout"><div class="ds-badge-scene"><div class="ds-badge-lanyard" aria-hidden="true"></div><div class="ds-badge"><div class="wordmark">Serra <span>Research</span><i></i></div><div class="ds-badge-avatar" aria-hidden="true"><span></span></div><strong>{p('Equipe de pesquisa','Research team')}</strong><span class="mono">{p('MODELO / SEM VALIDADE DE ACESSO','TEMPLATE / NOT VALID FOR ACCESS')}</span></div></div><div class="ds-print-notes"><article class="ds-lab-card"><h4>{p('Suporte físico','Physical substrate')}</h4><p>{p('Formato ID-1 de 85,60 × 53,98 mm. Selecionar material, espessura e acabamento conforme uso e durabilidade previstos.','ID-1 format of 85.60 × 53.98 mm. Select material, thickness and finish according to expected use and durability.')}</p></article><article class="ds-lab-card"><h4>{p('RFID / NFC e controle de acesso','RFID / NFC and access control')}</h4><p>{p('Tecnologia, chip, gestão de chaves e integração são requisitos de um sistema real. O mockup não possui funcionalidade de acesso nem credenciais válidas.','Technology, chip, key management and integration are requirements of a real system. The mockup has no access functionality or valid credentials.')}</p></article><article class="ds-lab-card"><h4>{p('Cordão e proteção','Lanyard and protection')}</h4><p>{p('Priorizar identificação legível, fecho de segurança e proteção de dados pessoais. A coleta e exposição de nome, foto e identificadores devem ser proporcionais à finalidade.','Prioritize legible identification, safety release and personal-data protection. Collection and display of names, photos and identifiers should be proportionate to their purpose.')}</p><a class="text-link" href={asset('field-badge.svg')} download>{p('Baixar modelo da credencial','Download badge template')}<Fragment set:html={arrow}/></a></article></div></div></section>
<section id="print-conversao" class="ds-print-detail" aria-labelledby="print-conversion-title"><div class="ds-print-heading"><span class="eyebrow">06 / {p('GESTÃO DE CORES','COLOR MANAGEMENT')}</span><h3 id="print-conversion-title">{p('Matriz de conversão gráfica','Print color conversion matrix')}</h3><span class="ds-spec-label mono">sRGB / CMYK {p('APROXIMADO','APPROXIMATE')}</span></div><div class="ds-table-wrap"><table><caption>{p('Valores RGB oficiais do site e conversão matemática CMYK aproximada, sem perfil ICC.','Official site RGB values and approximate mathematical CMYK conversion without an ICC profile.')}</caption><thead><tr>{[p('Amostra','Sample'),p('Nome','Name'),'HEX','RGB','CMYK (%)',p('Aplicação','Application')].map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{colors.map(([name,hex,use])=><tr><td><span class="ds-print-color" style={`background:${hex}`} aria-hidden="true"></span></td><th scope="row">{name}</th><td><code>{hex.toUpperCase()}</code></td><td>{convert(hex).rgb}</td><td>{convert(hex).cmyk}</td><td>{use}</td></tr>)}</tbody></table></div><div class="ds-two"><div class="ds-lab-card"><h4>{p('Prova, papel e ganho de ponto','Proofs, paper and dot gain')}</h4><p>{p('A reprodução depende do substrato e do processo. Confirmar perfil ICC, ganho de ponto, fidelidade do coral e sangria com uma prova física. Equivalências Pantone não são estabelecidas a partir de HEX.','Reproduction depends on substrate and process. Confirm ICC profile, dot gain, coral fidelity and bleed with a physical proof. Pantone matches cannot be established from HEX.')}</p></div><div class="ds-lab-card"><h4>{p('Carga de tinta e acabamento','Ink coverage and finishing')}</h4><p>{p('O limite de cobertura de tinta deve seguir as recomendações do perfil e da gráfica. A tabela serve para planejamento visual; não substitui separação de cores para impressão.','Ink coverage limits should follow profile and printer recommendations. The table supports visual planning; it does not replace print color separation.')}</p></div></div></section>
<section id="print-pre-impressao" class="ds-print-detail ds-prepress" aria-labelledby="print-kit-title"><div><span class="eyebrow">07 / {p('ARQUIVOS E REVISÃO','FILES AND REVIEW')}</span><h3 id="print-kit-title">{p('Kit de papelaria para revisão e produção','Stationery kit for review and production')}</h3><p>{p('Vetores SVG, PDF do timbrado A4, HTML editável, referência de cores e checklist de pré-impressão. Arquivos de demonstração em sRGB; não são PDF/X nem contêm certificação gráfica.','SVG vectors, an A4 letterhead PDF, editable HTML, color reference and a prepress checklist. Demonstration files use sRGB; they are not PDF/X and contain no print certification.')}</p></div><div class="ds-prepress-actions"><a class="button" href={asset('serra-stationery-kit.zip')} download>{p('Baixar kit completo (.zip)','Download complete kit (.zip)')}<Fragment set:html={arrow}/></a><a class="text-link" href={asset('prepress-checklist.txt')} download>{p('Baixar checklist para a gráfica','Download printer checklist')}<Fragment set:html={arrow}/></a></div></section>
