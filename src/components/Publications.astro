---
import {getCollection} from 'astro:content';
import {pick,type Locale} from '../i18n';
import {link,path,routes} from '../lib/site';
const {lang,section=true}=Astro.props as {lang:Locale;section?:boolean};
const p=(pt:string,en:string)=>pick(lang,pt,en);
const entries=(await getCollection('publications',({data})=>!data.draft&&data.language===lang)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<section class:list={['section','publications-section']} id={section?'publicacoes':undefined} aria-labelledby="publications-title"><div class="container">
 <div class="section-heading"><div><span class="eyebrow">{p('05 / CONHECIMENTO ABERTO','05 / OPEN KNOWLEDGE')}</span><h2 id="publications-title">{p('Pesquisa que se compartilha.','Research to share.')}<br/><span>{p('Evidência que se aprofunda.','Evidence to explore.')}</span></h2></div><p>{p('Um espaço para whitepapers, relatórios e notas técnicas. Métodos, fontes e limitações ao lado de cada resultado.','A space for whitepapers, reports and technical notes. Methods, sources and limitations alongside each finding.')}</p></div>
 <div class="publication-grid">
 {entries.slice(0,3).map(({data})=><article class="publication-card"><div class="eyebrow">{data.type} · {data.date.toLocaleDateString(lang==='pt'?'pt-BR':'en-GB',{dateStyle:'medium',timeZone:'UTC'})}</div>{data.demo&&<span class="research-demo-label mono">{p('PUBLICAÇÃO FICTÍCIA / DESENVOLVIMENTO','FICTIONAL PUBLICATION / DEVELOPMENT')}</span>}<h3><a href={path(`${routes.publications[lang]}/${data.slug}`)}>{data.title}</a></h3>{data.venue&&<p class="publication-venue">{data.venue.name}</p>}<p>{data.description}</p><div class="tags">{data.tags.map(tag=><span>{tag}</span>)}</div><a class="text-link" href={path(`${routes.publications[lang]}/${data.slug}`)}>{p('Ler publicação','Read publication')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></article>)}
 <article class="publication-card template-card"><div class="eyebrow"><span class="status-dot"></span>{p('MODELO EDITORIAL · SEM RESULTADOS DE PESQUISA','EDITORIAL TEMPLATE · NO RESEARCH FINDINGS')}</div><h3>{p('Do método à publicação.','From method to publication.')}</h3><p>{p('Conheça a estrutura preparada para compartilhar pesquisas: resumo, metodologia, evidências, limitações e referências. Este é um modelo demonstrativo.','Explore the structure prepared for sharing research: abstract, methodology, evidence, limitations and references. This is a demonstration template.')}</p><div class="tags"><span>Markdown</span><span>{p('Fontes rastreáveis','Traceable sources')}</span><span>{p('Versão bilíngue','Bilingual editions')}</span></div><a class="text-link" href={link('template',lang)}>{p('Explorar modelo de whitepaper','Explore the whitepaper template')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></article>
 </div>
 {section&&<a class="text-link publication-index-link" href={link('publications',lang)}>{p('Ver biblioteca de publicações','Explore the publication library')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>}
</div></section>
