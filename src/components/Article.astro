---
import {render,getCollection,type CollectionEntry} from 'astro:content';
import Base from '../layouts/Base.astro';
import PublicationDetails from './PublicationDetails.astro';
import {pick} from '../i18n';
import {path,link,routes,origin,home} from '../lib/site';
import {publicationMetadata,resourceHref} from '../lib/publication-metadata';
import {northeast} from '../lib/visuals';
interface Props {entry:CollectionEntry<'publications'>;translation?:CollectionEntry<'publications'>;}
const {entry,translation}=Astro.props;
const {Content,headings}=await render(entry);
const d=entry.data;const lang=d.language;const p=(pt:string,en:string)=>pick(lang,pt,en);
const alternate=translation?path(`${routes.publications[translation.data.language]}/${translation.data.slug}`):link('publications',lang==='pt'?'en':'pt');
const format=(date:Date)=>date.toLocaleDateString(lang==='pt'?'pt-BR':'en-GB',{dateStyle:'long',timeZone:'UTC'});
const canonical=new URL(Astro.url.pathname,origin).href;
const metadata=publicationMetadata(d,canonical);
const abstractTitle=d.type==='Whitepaper'?p('Resumo executivo','Executive abstract'):p('Resumo','Abstract');
const related=d.draft?[]:(await getCollection('publications',({data})=>!data.draft&&data.demo===d.demo&&data.language===lang&&data.translationKey!==d.translationKey)).map(other=>({entry:other,score:d.related.includes(other.data.translationKey)?100:other.data.tags.filter(tag=>d.tags.includes(tag)).length})).filter(other=>other.score>0).sort((a,b)=>b.score-a.score||b.entry.data.date.getTime()-a.entry.data.date.getTime()).slice(0,3).map(other=>other.entry);
---
<Base lang={lang} title={`${d.title} — Serra Research`} description={d.description} alternate={alternate} noindex={d.draft||d.demo} hasTranslation={!!translation} article={d.draft||d.demo?undefined:metadata.structured} citations={d.draft||d.demo?[]:metadata.citations}>
 <main id="conteudo" tabindex="-1" class="article-main"><article class="container">
 <nav class="publication-breadcrumbs" aria-label={p('Caminho da publicação','Publication breadcrumb')}><ol><li><a href={home(lang)}>{p('Início','Home')}</a></li><li><a href={link('publications',lang)}>{p('Publicações','Publications')}</a></li><li><span aria-current="page">{d.title}</span></li></ol></nav>
 {d.draft&&<div class="template-notice"><span class="status-dot"></span>{p('Modelo demonstrativo. Não é uma pesquisa publicada e não contém resultados empíricos.','Demonstration template. This is not published research and contains no empirical findings.')}</div>}
 {d.demo&&<div class="template-notice demo-notice"><span class="status-dot"></span>{p('Publicação fictícia para desenvolvimento do site. Autoria, cenários e resultados são demonstrativos e não devem ser usados como evidência científica.','Fictional publication for website development. Authorship, scenarios and findings are demonstrations and must not be used as scientific evidence.')}</div>}
 <header class="article-heading"><span class="eyebrow">{d.venue?.name||'SERRA'} / {d.type.toUpperCase()}</span><h1>{d.title}</h1><p class="article-description">{d.description}</p><div class="article-meta"><span>{d.authors.map(a=>a.name).join(' · ')}</span><time datetime={d.date.toISOString()}>{d.draft?p('Modelo atualizado: ','Template updated: '):''}{format(d.date)}</time>{d.updated&&<time datetime={d.updated.toISOString()}>{p('Revisado: ','Revised: ')}{format(d.updated)}</time>}{d.doi&&<a href={`https://doi.org/${d.doi}`} rel="noopener">DOI: {d.doi}</a>}</div><div class="tags" aria-label={p('Temas','Topics')}>{d.tags.map(tag=><span>{tag}</span>)}</div></header>
 <div class="article-layout"><aside class="article-toc"><nav aria-label={p('Sumário da publicação','Publication contents')}><strong class="mono">{p('NESTA PUBLICAÇÃO','IN THIS PUBLICATION')}</strong><a href="#abstract">{abstractTitle}</a>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#publication-details">{p('Ficha da publicação','Publication details')}</a>{(d.pdf||d.publicationUrl||d.resources.length>0)&&<a href="#resources">{p('Recursos','Resources')}</a>}{(d.funding.length||d.conflicts||d.ethics||d.dataAvailability)&&<a href="#research-transparency">{p('Transparência','Transparency')}</a>}{!d.draft&&<a href="#citation">{p('Como citar','How to cite')}</a>}</nav><button class="text-link" id="share-publication">{p('Copiar link','Copy link')}<Fragment set:html={northeast}/></button><p id="share-status" role="status"></p>{d.pdf&&<a class="button button-small" href={resourceHref(d.pdf)} download>{p('Baixar PDF','Download PDF')} ↓</a>}</aside>
 <div class="article-body"><section class="abstract" id="abstract" aria-labelledby="abstract-title"><span class="eyebrow">ABSTRACT</span><h2 id="abstract-title">{abstractTitle}</h2><p>{d.abstract}</p></section><div class="prose"><Content/></div><PublicationDetails data={d}/>{!d.draft&&<section class="citation" id="citation" aria-labelledby="citation-title"><h2 id="citation-title">{p('Como citar','How to cite')}</h2><p>{metadata.citation}</p><a class="text-link" href={`data:application/x-bibtex;charset=utf-8,${encodeURIComponent(metadata.bibtex)}`} download={`${d.slug}.bib`}>{p('Baixar citação BibTeX','Download BibTeX citation')}<Fragment set:html={northeast}/></a><details class="citation-code"><summary>{p('Ver BibTeX','View BibTeX')}</summary><pre><code>{metadata.bibtex}</code></pre></details></section>}</div></div>
 {related.length>0&&<section class="related-publications" aria-labelledby="related-title"><span class="eyebrow">{p('CONTINUAR A LEITURA','KEEP READING')}</span><h2 id="related-title">{p('Pesquisas relacionadas','Related research')}</h2><div class="publication-grid">{related.map(({data:r})=><article class="publication-card"><div class="eyebrow">{r.type} · {r.venue?.name||format(r.date)}</div><h3><a href={path(`${routes.publications[lang]}/${r.slug}`)}>{r.title}</a></h3><p>{r.authors.slice(0,2).map(a=>a.name).join(' · ')}{r.authors.length>2?' · et al.':''}</p><a class="text-link" href={path(`${routes.publications[lang]}/${r.slug}`)}>{p('Ler publicação','Read publication')}<Fragment set:html={northeast}/></a></article>)}</div></section>}
 </article></main>
</Base>
