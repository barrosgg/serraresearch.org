---
import {getCollection} from 'astro:content';
import '../research-library.css';
import {pick,type Locale} from '../i18n';
import {home,link,path,routes} from '../lib/site';
import {icon,arrow,northeast} from '../lib/visuals';
const {lang}=Astro.props as {lang:Locale};const p=(pt:string,en:string)=>pick(lang,pt,en);
const entries=(await getCollection('publications',({data})=>!data.draft&&data.language===lang)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.date.getTime()-a.data.date.getTime());
const topics=[...new Set(entries.map(({data})=>data.tags[0]).filter(Boolean))];
const years=[...new Set(entries.map(({data})=>data.date.getUTCFullYear()))].sort((a,b)=>b-a);
const types=[...new Set(entries.map(({data})=>data.type))];
const index=entries.map(({id,data:d})=>({id,title:d.title,abstract:d.abstract,authors:d.authors.map(a=>a.name+' '+a.affiliations.join(' ')).join(' '),tags:d.tags,topic:d.tags[0]||'',year:String(d.date.getUTCFullYear()),type:d.type,date:d.date.toISOString(),doi:d.doi||'',venue:d.venue?.name||'',report:d.reportNumber||'',featured:d.featured}));
const format=(date:Date)=>date.toLocaleDateString(lang==='pt'?'pt-BR':'en-GB',{dateStyle:'medium',timeZone:'UTC'});
const searchIcon='<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
---
<div class="container research-library">
 <div class="library-breadcrumb"><a class="text-link" href={home(lang)}>← {p('Início','Home')}</a><span class="mono">SERRA LAB / RESEARCH DISCOVERY INDEX</span></div>
 <header class="library-heading"><div><div class="eyebrow"><span class="status-dot"></span>{p('REPOSITÓRIO SERRA RESEARCH','SERRA RESEARCH REPOSITORY')}</div><h1>{p('Publicações científicas','Scientific publications')} <span>& whitepapers.</span></h1></div><div><span class="library-record-total mono"><span class="status-dot"></span>{entries.length} {p('REGISTROS NA BIBLIOTECA','LIBRARY RECORDS')}</span><p>{p('Pesquisa em educação, sociedade e território. Métodos, dados e tecnologias organizados para compartilhar conhecimento e aprofundar decisões.','Research in education, society and territories. Methods, data and technologies organized to share knowledge and inform decisions.')}</p></div></header>
 {entries.some(({data})=>data.demo)&&<aside class="library-demo-note"><span set:html={icon('research')}/><p>{p('Acervo demonstrativo para desenvolvimento do site. As publicações marcadas como fictícias apresentam cenários e dados sintéticos.','Demonstration collection for website development. Publications marked as fictional contain synthetic scenarios and data.')}</p></aside>}
 <section class="library-filter-panel" aria-labelledby="library-search-title"><h2 id="library-search-title" class="sr-only">{p('Buscar e filtrar publicações','Search and filter publications')}</h2><label for="publication-search">{p('Pesquisar no acervo','Search the collection')}</label><div class="library-search"><span set:html={searchIcon}/><input id="publication-search" type="search" placeholder={p('Título, autor, resumo, DOI ou palavra-chave…','Title, author, abstract, DOI or keyword…')} autocomplete="off" disabled/><kbd aria-hidden="true">Ctrl / ⌘ K</kbd></div><div class="library-topics" role="group" aria-label={p('Filtrar por tema','Filter by topic')}><span class="mono">{p('TEMA','TOPIC')}</span><button type="button" data-topic="" aria-pressed="true" disabled>{p('Todos','All')} <span>{entries.length}</span></button>{topics.map(topic=><button type="button" data-topic={topic} aria-pressed="false" disabled>{topic}<span>{entries.filter(({data})=>data.tags[0]===topic).length}</span></button>)}</div><div class="library-selects"><label for="publication-year">{p('Ano','Year')}<select id="publication-year" disabled><option value="">{p('Todos os anos','All years')}</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><label for="publication-type">{p('Tipo','Type')}<select id="publication-type" disabled><option value="">{p('Todos os formatos','All formats')}</option>{types.map(type=><option value={type}>{type}</option>)}</select></label><label for="publication-sort">{p('Ordenar','Sort')}<select id="publication-sort" disabled><option value="recent">{p('Mais recentes','Newest first')}</option><option value="oldest">{p('Mais antigas','Oldest first')}</option><option value="title">{p('Título A–Z','Title A–Z')}</option></select></label><button type="button" class="text-link" id="reset-publication-filters" disabled>{p('Limpar filtros','Clear filters')}<span aria-hidden="true">×</span></button></div></section>
 <div class="library-results-bar"><p id="publication-result-status" role="status" aria-live="polite" aria-atomic="true">{entries.length} {p('publicações disponíveis','publications available')}</p><a class="text-link" href={link('editor',lang)}>{p('Preparar publicação','Prepare a publication')}<Fragment set:html={northeast}/></a></div>
 <div class="library-results" id="publication-results">{entries.map(({id,data:d})=><article class:list={['research-record',{featured:d.featured}]} data-record={id}>
  <div class="research-record-content"><div class="research-record-meta"><span class="mono">{d.featured?p('DESTAQUE / ','FEATURED / ')+d.type.toUpperCase():d.type.toUpperCase()}</span><time datetime={d.date.toISOString()}>{format(d.date)}</time></div>{d.demo&&<span class="research-demo-label mono">{p('EXEMPLO FICTÍCIO / DESENVOLVIMENTO','FICTIONAL EXAMPLE / DEVELOPMENT')}</span>}<h2><a href={path(`${routes.publications[lang]}/${d.slug}`)}>{d.title}</a></h2><div class="research-record-authors"><span class="mono">{p('AUTORES E UNIDADES DE PESQUISA','AUTHORS & RESEARCH UNITS')}</span><p>{d.authors.map(a=>a.name).join(' · ')}</p>{d.authors[0]?.affiliations.length>0&&<p class="research-affiliation">{d.authors[0].affiliations.join(' · ')}</p>}</div><div class="research-abstract"><span class="mono">{p('RESUMO / ABSTRACT','ABSTRACT')}</span><p>{d.featured?d.abstract:d.description}</p></div><div class="tags">{d.tags.map(tag=><span>{tag}</span>)}</div><div class="research-record-actions"><a class="button button-small" href={path(`${routes.publications[lang]}/${d.slug}`)}>{p('Ler publicação','Read publication')}<Fragment set:html={arrow}/></a>{d.doi?<a class="text-link" href={`https://doi.org/${d.doi}`}>DOI<Fragment set:html={northeast}/></a>:<span class="mono">{d.demo?p('SEM DOI · EXEMPLO EDITORIAL','NO DOI · EDITORIAL EXAMPLE'):d.type.toUpperCase()}</span>}</div></div>
  {d.featured&&<aside class="research-feature-panel" aria-label={p('Ficha do destaque','Featured publication details')}><span class="mono">{d.demo?p('FICHA DO EXEMPLO','EXAMPLE DETAILS'):p('FICHA DA PUBLICAÇÃO','PUBLICATION DETAILS')}</span><div class="research-feature-facts"><div><strong>{d.date.getUTCFullYear()}</strong><span class="mono">{p('ANO','YEAR')}</span></div><div><strong>{d.tags.length}</strong><span class="mono">{p('TEMAS','TOPICS')}</span></div><div><strong>{d.authors.length}</strong><span class="mono">{p('AUTORES','AUTHORS')}</span></div><div><strong class="feature-version">{d.version||'—'}</strong><span class="mono">{p('VERSÃO','VERSION')}</span></div></div>{d.demo&&<figure class="research-synthetic-chart"><figcaption class="mono">{p('SÉRIES SINTÉTICAS / ILUSTRAÇÃO','SYNTHETIC SERIES / ILLUSTRATION')}</figcaption><svg viewBox="0 0 300 110" aria-hidden="true"><g stroke="#dfe1ea"><path d="M15 25h270M15 55h270M15 85h270"/></g><path d="M15 62 69 56 123 68 177 44 231 38 285 26" fill="none" stroke="#fd5638" stroke-width="2"/><path d="M15 86 69 80 123 74 177 62 231 68 285 56" fill="none" stroke="#0057ff" stroke-width="2"/><g fill="#0057ff"><circle cx="177" cy="62" r="3"/><circle cx="285" cy="56" r="3"/></g></svg><div class="mono"><span>{p('JAN / A: 82 · B: 78','JAN / A: 82 · B: 78')}</span><span>{p('JUN / A: 88 · B: 83','JUN / A: 88 · B: 83')}</span></div><p>{p('Dados inventados; tabela e contexto na publicação.','Invented data; table and context in the publication.')}</p></figure>}<div class="research-feature-context"><span set:html={icon('globe')}/><div><span class="mono">{p('FRENTE DE PESQUISA','RESEARCH AREA')}</span><p>{d.tags[0]}</p></div></div></aside>}
 </article>)}</div>
 <div id="publication-empty-state" class="library-empty" hidden><span set:html={searchIcon}/><h2>{p('Nenhuma publicação encontrada.','No publications found.')}</h2><p>{p('Tente outra palavra-chave ou remova os filtros.','Try a different keyword or clear the filters.')}</p><button type="button" class="button button-blue" id="reset-empty-search">{p('Ver todo o acervo','View the whole collection')}<Fragment set:html={arrow}/></button></div>
 <aside class="library-editorial-callout"><div><span class="eyebrow">{p('DA PESQUISA À PUBLICAÇÃO','FROM RESEARCH TO PUBLICATION')}</span><h2>{p('Uma estrutura para compartilhar evidências.','A structure for sharing evidence.')}</h2><p>{p('Prepare metadados, autoria, fontes e o texto no editor. Ou explore o modelo científico antes de escrever.','Prepare metadata, authorship, sources and text in the editor. Or explore the scientific template before writing.')}</p></div><div><a class="button button-blue" href={link('editor',lang)}>{p('Preparar publicação','Prepare a publication')}<Fragment set:html={arrow}/></a><a class="text-link" href={link('template',lang)}>{p('Explorar template','Explore the template')}<Fragment set:html={northeast}/></a></div></aside>
 <noscript><p class="library-static-note">{p('O acervo completo pode ser lido sem JavaScript. Busca e filtros exigem JavaScript.','The complete collection can be read without JavaScript. Search and filters require JavaScript.')}</p></noscript>
 <script id="research-library-data" type="application/json" set:html={JSON.stringify({lang,entries:index}).replace(/</g,'\\u003c')}/>
</div>
<script>import '../scripts/library';</script>
