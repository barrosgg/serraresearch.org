---
import {pick,type Locale} from '../i18n';
import {path} from '../lib/site';
import {arrow} from '../lib/visuals';
import {researchDesign as d} from '../lib/research-design';
import {contrastRatio} from '../lib/design-system';
const {lang,part='charts'}=Astro.props as {lang:Locale;part?:'spectral'|'charts'};
const p=(pt:string,en:string)=>pick(lang,pt,en);
const asset=(name:string)=>path(`design/${name}`).replace(/\/$/,'');
const spectra=[
 ['bio',p('Hiperespectral e vegetação','Hyperspectral imagery and vegetation'),'NDVI / BIO',p('Curvas de reflectância e índice NDVI esquemáticos. Verde, amarelo e musgo identificam a família biofísica; este desenho não é uma medição hiperespectral.','Schematic reflectance curves and NDVI. Green, yellow and moss identify the biophysical family; this drawing is not a hyperspectral measurement.')],
 ['hydro',p('Dinâmica hidrológica e bacias','Hydrological dynamics and basins'),'Q50 / HYDRO',p('Isóbatas, contornos de profundidade e vetores de escoamento. Q50 e profundidade são valores ilustrativos.','Isobaths, depth contours and flow vectors. Q50 and depth are illustrative values.')],
 ['thermal',p('Anomalias térmicas e radiometria','Thermal anomalies and radiometry'),'LST / THERMAL',p('Gradiente em laranja, carmim e âmbar para focos térmicos. Temperatura não permite inferir emissões de CO₂ sem dados e modelos adicionais.','An orange, crimson and amber gradient for thermal hotspots. Temperature cannot establish CO₂ emissions without additional data and models.')],
 ['sar',p('Radar SAR e geologia estrutural','SAR radar and structural geology'),'C-BAND / VV',p('Perfis e franjas esquemáticos em ardósia e índigo. Polarização VV indicada; deslocamento exige processamento interferométrico e validação.','Schematic profiles and fringes in slate and indigo. VV polarization is indicated; displacement requires interferometric processing and validation.')],
];
const colors=[d.charts.emerald,d.charts.water,d.charts.amber,d.charts.coral];
const classes=[p('Bio / conservação','Bio / conservation'),p('Agrofloresta','Agroforestry'),p('Transição','Transition'),p('Frente crítica','Critical frontier')];
const n=d.scatter.length,mx=d.scatter.reduce((s,r)=>s+r.x,0)/n,my=d.scatter.reduce((s,r)=>s+r.y,0)/n;
const slope=d.scatter.reduce((s,r)=>s+(r.x-mx)*(r.y-my),0)/d.scatter.reduce((s,r)=>s+(r.x-mx)**2,0),intercept=my-slope*mx;
const r2=1-d.scatter.reduce((s,r)=>s+(r.y-(intercept+slope*r.x))**2,0)/d.scatter.reduce((s,r)=>s+(r.y-my)**2,0);
const kde=(axis:'x'|'y')=>Array.from({length:51},(_,i)=>({position:i*2,density:d.scatter.reduce((sum,r)=>sum+Math.exp(-.5*((i*2-r[axis])/10)**2),0)/(n*10*Math.sqrt(2*Math.PI))}));
const kx=kde('x'),ky=kde('y'),peak=Math.max(...kx.map(r=>r.density),...ky.map(r=>r.density));
const kxPoints=kx.map(r=>`${60+r.position*3.7},${55-r.density/peak*35}`).join(' ');
const kyPoints=ky.map(r=>`${450+r.density/peak*35},${270-r.position*2}`).join(' ');
const series=(key:'trend'|'seasonal'|'residual')=>d.decomposition.map((r,i)=>`${50+i*17.5},${key==='trend'?90-(r.trend-35)*2:key==='seasonal'?170-r.seasonal*3:270-r.residual*3}`).join(' ');
const flowPoints=d.flow.map(r=>`${60+r.exceedance*3.8},${255-(Math.log10(r.value)-.8)*100}`).join(' ');
const severityLabels=[p('Basal','Baseline'),p('Baixo','Low'),p('Moderado','Moderate'),p('Alto','High'),p('Crítico','Critical')];
---
{part==='spectral'?<div class="ds-new-spectra" id="spectral-families"><div class="ds-section-heading"><h3>{p('Diversidade cromática e espectros multiespectrais','Color diversity and multispectral families')}</h3><p>{p('Quatro famílias semânticas, com rótulos completos. Esquemas ilustrativos, sem observação de campo.','Four semantic families with complete labels. Illustrative diagrams without field observations.')}</p></div><div class="ds-spectral-gallery">{spectra.map(([key,title,code,copy])=><article class="ds-lab-card ds-spectrum-card" style={`--spectrum:${({bio:d.spectral.vegetation,hydro:d.spectral.water,thermal:d.spectral.thermal,sar:d.spectral.radar} as Record<string,string>)[key]}`}><span class="ds-spec-label mono">{code}</span><div class="ds-illustration-stage"><img src={asset(`illustrations/spectral-${key}${lang==='en'?'-en':''}.svg`)} alt={title} width="200" height="160" loading="lazy"/></div><h4>{title}</h4><p>{copy}</p><div class="ds-spectrum-swatches" aria-label={p('Cores da família','Family colors')}>{d.spectralFamilies[key as keyof typeof d.spectralFamilies].map(color=><span><i style={`background:${color}`} aria-hidden="true"></i><code>{color.toUpperCase()}</code></span>)}</div><a class="text-link" href={asset(`illustrations/spectral-${key}${lang==='en'?'-en':''}.svg`)} download>{p('Baixar SVG','Download SVG')}<Fragment set:html={arrow}/></a></article>)}</div><div class="ds-lab-panel" id="spectral-token-matrix"><h4>{p('Matriz semântica de ilustração científica','Scientific illustration semantic matrix')}</h4><div class="ds-table-wrap"><table><thead><tr><th scope="col">Token</th><th scope="col">{p('Paleta','Palette')}</th><th scope="col">{p('Domínio e limites','Domain and limitations')}</th></tr></thead><tbody>{spectra.map(([key,,,copy])=><tr><th scope="row"><code>ilus.spectrum.{key}</code></th><td>{d.spectralFamilies[key as keyof typeof d.spectralFamilies].join(' / ').toUpperCase()}</td><td>{copy}</td></tr>)}</tbody></table></div></div></div>:<div class="ds-advanced-examples" id="advanced-dataviz"><div class="ds-section-heading"><h3>{p('Gráficos avançados e rigor multivariado','Advanced charts and multivariate rigor')}</h3><p>{p('Dados sintéticos para desenvolvimento. Métodos, unidades, legendas e tabelas acompanham os desenhos; os valores não são resultados institucionais.','Synthetic development data. Methods, units, legends and tables accompany the graphics; values are not institutional findings.')}</p></div><div class="ds-dataviz-grid">
<figure class="ds-lab-card ds-chart" id="chart-scatter-kde"><div class="ds-panel-heading"><h4>{p('Dispersão multivariada e densidade marginal','Multivariate scatter and marginal density')}</h4><span class="ds-spec-label mono">OLS / KDE</span></div><svg class="ds-data-svg" viewBox="0 0 520 340" aria-hidden="true"><path d="M60 70V270H430" fill="none" stroke="#a7a9b0"/><g stroke="#dfe1ea" stroke-dasharray="3 4"><path d="M60 170H430M245 70V270"/></g><polygon points={`60,55 ${kxPoints} 430,55`} fill="#2d3139" fill-opacity=".08"/><polyline points={kxPoints} fill="none" stroke="#64748b"/><polygon points={`450,270 ${kyPoints} 450,70`} fill="#2d3139" fill-opacity=".08"/><polyline points={kyPoints} fill="none" stroke="#64748b"/><line x1="60" y1={270-intercept*2} x2="430" y2={270-(intercept+slope*100)*2} stroke={d.charts.coral} stroke-width="2"/>{d.scatter.map(r=><circle cx={60+r.x*3.7} cy={270-r.y*2} r="3.5" fill={colors[r.group]}/>)}<text x="60" y="290">0</text><text x="240" y="290">50</text><text x="412" y="290">100</text><text x="35" y="274">0</text><text x="29" y="174">50</text><text x="23" y="74">100</text><text x="112" y="320">{p('PRESSÃO / ÍNDICE SINTÉTICO','PRESSURE / SYNTHETIC INDEX')}</text><text transform="translate(16 255) rotate(-90)">{p('VULNERABILIDADE / 0–100','VULNERABILITY / 0–100')}</text><g class="ds-chart-annotation"><rect x="240" y="225" width="178" height="26" rx="3" fill="#2d3139"/><text x="250" y="242">R² = {r2.toFixed(3)} / n = {n}</text></g></svg><div class="ds-chart-legend">{classes.map((label,i)=><span><i style={`border-color:${colors[i]}`} class="ds-line-key" aria-hidden="true"></i>{label}</span>)}</div><figcaption>{p('OLS calculado sobre 13 pontos sintéticos. KDE gaussiana marginal, largura de banda 10; densidades normalizadas para exibição. Associação não estabelece causalidade.','OLS calculated from 13 synthetic points. Gaussian marginal KDE, bandwidth 10; densities normalized for display. Association does not establish causality.')}</figcaption><details class="ds-data-details"><summary>{p('Ver pontos e categorias','View points and categories')}</summary><div class="ds-data-table"><table><thead><tr><th scope="col">X</th><th scope="col">Y</th><th scope="col">{p('Categoria','Category')}</th></tr></thead><tbody>{d.scatter.map(r=><tr><td>{r.x}</td><td>{r.y}</td><td>{classes[r.group]}</td></tr>)}</tbody></table></div></details></figure>
<figure class="ds-lab-card ds-chart" id="chart-decomposition"><div class="ds-panel-heading"><h4>{p('Decomposição de séries temporais','Time-series decomposition')}</h4><span class="ds-spec-label mono">STL / {p('ESQUEMA','SCHEMATIC')}</span></div><svg class="ds-data-svg" viewBox="0 0 520 340" aria-hidden="true"><text x="50" y="24">{p('1 / TENDÊNCIA','1 / TREND')}</text><polyline points={series('trend')} fill="none" stroke={d.charts.coral} stroke-width="2"/><text x="50" y="125">{p('2 / SAZONALIDADE (12 PERÍODOS)','2 / SEASONALITY (12 PERIODS)')}</text><line x1="50" x2="453" y1="170" y2="170" stroke="#dfe1ea"/><polyline points={series('seasonal')} fill="none" stroke={d.charts.water} stroke-width="1.5"/><text x="50" y="223">{p('3 / RESÍDUOS (LIMIAR ILUSTRATIVO ±3)','3 / RESIDUALS (ILLUSTRATIVE ±3 LIMIT)')}</text><rect x="50" y="261" width="403" height="18" fill="#2d3139" fill-opacity=".05"/><line x1="50" x2="453" y1="270" y2="270" stroke="#a7a9b0"/>{d.decomposition.map((r,i)=><g><line x1={50+i*17.5} x2={50+i*17.5} y1="270" y2={270-r.residual*3} stroke={Math.abs(r.residual)>3?d.charts.coral:d.charts.graphite}/><circle cx={50+i*17.5} cy={270-r.residual*3} r={Math.abs(r.residual)>3?3:1.5} fill={Math.abs(r.residual)>3?d.charts.coral:d.charts.graphite}/></g>)}<text x="50" y="307">1</text><text x="243" y="307">12</text><text x="440" y="307">24</text><text x="210" y="330">{p('PERÍODO','PERIOD')}</text></svg><figcaption>{p('Série construída como tendência + seno sazonal + resíduo, em unidades sintéticas. Ilustra as três trilhas de STL; não executa ajuste LOESS, teste de anomalias ou estimação de limites estatísticos.','Series constructed as trend + seasonal sine + residual, in synthetic units. Illustrates STL’s three tracks; does not perform LOESS fitting, anomaly testing or statistical limit estimation.')}</figcaption><details class="ds-data-details"><summary>{p('Ver componentes e série reconstruída','View components and reconstructed series')}</summary><div class="ds-data-table"><table><thead><tr>{[p('Período','Period'),p('Tendência','Trend'),p('Sazonal','Seasonal'),p('Resíduo','Residual'),p('Série','Series')].map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{d.decomposition.map(r=><tr><th scope="row">{r.period}</th><td>{r.trend.toFixed(1)}</td><td>{r.seasonal}</td><td>{r.residual}</td><td>{(r.trend+r.seasonal+r.residual).toFixed(2)}</td></tr>)}</tbody></table></div></details></figure>
<figure class="ds-lab-card ds-chart" id="chart-flow-duration"><div class="ds-panel-heading"><h4>{p('Curva de duração de vazão','Flow duration curve')}</h4><span class="ds-spec-label mono">FDC / LOG</span></div><svg class="ds-data-svg" viewBox="0 0 520 340" aria-hidden="true">{[d.charts.emerald,d.charts.amber,d.charts.coral,'#e11d48'].map((color,i)=><rect x={60+[0,20,50,85][i]*3.8} y="35" width={[20,30,35,15][i]*3.8} height="225" fill={color} fill-opacity=".09"/>)}<path d="M60 35V260H440" fill="none" stroke="#a7a9b0"/><g stroke="#dfe1ea" stroke-dasharray="3 4"><path d="M60 235H440M60 135H440M60 35H440"/></g><polyline points={flowPoints} fill="none" stroke={d.charts.water} stroke-width="2"/>{[10,50,95].map(value=><g><line x1={60+value*3.8} x2={60+value*3.8} y1="35" y2="260" stroke={value===95?d.charts.coral:d.charts.water} stroke-dasharray="3 3"/><text x={60+value*3.8} y="25" text-anchor="middle">Q{value}</text></g>)}<text x="23" y="239">10</text><text x="16" y="139">100</text><text x="9" y="39">1000</text><text x="60" y="280">0</text><text x="240" y="280">50</text><text x="420" y="280">100</text><text x="102" y="310">{p('TEMPO IGUALADO OU SUPERADO (%)','TIME EQUALED OR EXCEEDED (%)')}</text><text x="60" y="330">m³/s / LOG₁₀</text></svg><div class="ds-chart-legend">{[p('0–20%','0–20%'),p('20–50%','20–50%'),p('50–85%','50–85%'),p('85–100%','85–100%')].map((label,i)=><span><i class="ds-line-key" style={`border-color:${[d.charts.emerald,d.charts.amber,d.charts.coral,'#e11d48'][i]}`} aria-hidden="true"></i>{label}</span>)}</div><figcaption>{p('Vazões sintéticas positivas em escala logarítmica. Q10 = 610, Q50 = 98 e Q95 = 9 m³/s. Faixas ilustram permanência; classificação de risco hídrico exige contexto, demanda e método próprios.','Positive synthetic flows on a logarithmic scale. Q10 = 610, Q50 = 98 and Q95 = 9 m³/s. Bands illustrate exceedance; water-risk classification requires context, demand and its own method.')}</figcaption><details class="ds-data-details"><summary>{p('Ver permanência e vazão','View exceedance and flow')}</summary><div class="ds-data-table"><table><thead><tr><th scope="col">{p('Permanência (%)','Exceedance (%)')}</th><th scope="col">m³/s</th></tr></thead><tbody>{d.flow.map(r=><tr><th scope="row">{r.exceedance}</th><td>{r.value}</td></tr>)}</tbody></table></div></details></figure>
<figure class="ds-lab-card ds-chart" id="chart-severity"><div class="ds-panel-heading"><h4>{p('Matriz territorial e gradiente sequencial','Territorial matrix and sequential gradient')}</h4><span class="ds-spec-label mono">GEO / 5</span></div><div class="ds-severity-stage"><table class="ds-severity-table"><caption class="sr-only">{p('Matriz sintética, quatro linhas e oito colunas, níveis de 0 a 4.','Synthetic four-row, eight-column matrix, levels 0 through 4.')}</caption><tbody>{d.severity.map((row,i)=><tr>{row.map((value,j)=><td style={`background:${d.palettes.sequential[value]};color:${contrastRatio('#181c22',d.palettes.sequential[value])>=4.5?'#181c22':'#fff'}`}><span class="sr-only">{p('Célula','Cell')} {i+1}/{j+1}: </span>{value}</td>)}</tr>)}</tbody></table></div><div class="ds-chart-legend">{severityLabels.map((label,i)=><span><i class="ds-line-key" style={`border-color:${d.palettes.sequential[i]}`} aria-hidden="true"></i>{i} / {label}</span>)}</div><figcaption>{p('Índice ordinal sintético. Células esquemáticas, sem geolocalização, área de amostragem ou Gini observado. Os números permitem leitura além da cor.','Synthetic ordinal index. Schematic cells without geolocation, sampling area or an observed Gini coefficient. Numbers provide meaning beyond color.')}</figcaption></figure>
</div><div class="ds-lab-panel" id="dataviz-palette-guide"><h4>{p('Paletas avançadas e contraste medido','Advanced palettes and measured contrast')}</h4><p>{p('Contraste de cada amostra sobre branco. Cores de dados não garantem contraste suficiente para texto pequeno; usar a tinta acessível e rótulos redundantes. Não há certificação AAA presumida.','Contrast of each swatch against white. Data colors do not guarantee sufficient contrast for small text; use accessible ink and redundant labels. No AAA certification is assumed.')}</p><div class="ds-table-wrap"><table><thead><tr><th scope="col">{p('Família','Family')}</th><th scope="col">{p('Cores e contraste sobre branco','Colors and contrast against white')}</th><th scope="col">{p('Uso','Usage')}</th></tr></thead><tbody>{Object.entries(d.palettes).map(([key,palette],i)=><tr><th scope="row"><code>{key}</code></th><td><div class="ds-spectrum-swatches">{palette.map(color=><span><i style={`background:${color}`} aria-hidden="true"></i><code>{color.toUpperCase()} / {contrastRatio(color,'#ffffff').toFixed(2)}:1</code></span>)}</div></td><td>{[p('Categorias distintas, com rótulos.','Distinct categories with labels.'),p('Desvios em torno de um centro documentado.','Deviations around a documented center.'),p('Magnitude ordenada, acompanhada de escala.','Ordered magnitude with an accompanying scale.')][i]}</td></tr>)}</tbody></table></div></div></div>}
