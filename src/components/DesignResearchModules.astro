---
import DesignPrintModules from './DesignPrintModules.astro';
import {pick,type Locale} from '../i18n';
import {path,email} from '../lib/site';
import {icon,arrow,northeast} from '../lib/visuals';
import {contrastRatio} from '../lib/design-system';
import {researchDesign as data} from '../lib/research-design';
const {lang,part='research'}=Astro.props as {lang:Locale;part?:'research'|'print'};const p=(pt:string,en:string)=>pick(lang,pt,en);
const file=(name:string)=>path(`design/${name}`).replace(/\/$/,'');
const illustrationFile=(name:string)=>file(`illustrations/${name}${lang==='en'&&['soil-layers','watershed'].includes(name)?'-en':''}.svg`);
const illustrationLabels:Record<string,string>={'soil-layers':p('SONDA Z-04','PROBE Z-04'),watershed:p('EXUTÓRIO Q50','OUTLET Q50'),'polar-orbit':'SWATH: 290 KM'};
const illustrations=[
 ['spectral-orb','01 / RADIAL',p('Orbe espectral e sensoriamento','Spectral orb and sensing'),p('Gradientes radiais translúcidos e órbitas finas para representar observação, alcance e azimute.','Translucent radial gradients and fine orbits represent observation, range and azimuth.')],
 ['soil-layers','02 / STRATA',p('Camadas estratigráficas e solo','Stratigraphic layers and soil'),p('Curvas em grafite, horizontes sobrepostos e um ponto focal coral para leitura de camadas.','Graphite curves, overlapping horizons and a coral focal point for reading layers.')],
 ['telemetry-grid','03 / GRID',p('Coordenadas e telemetria','Coordinates and telemetry'),p('Malha ortogonal com agrupamentos de pontos. Linhas pontilhadas delimitam regiões de interesse.','An orthogonal grid with point clusters. Dotted lines delineate regions of interest.')],
 ['watershed','04 / HYDRO',p('Bacia hidrográfica e drenagem','Watershed and drainage'),p('Ramificações azuis e espessuras distintas para diferenciar cursos d’água e confluências.','Blue branches and distinct line widths differentiate waterways and confluences.')],
 ['polar-orbit','05 / ORBIT',p('Órbita polar e varredura','Polar orbit and scanning'),p('Globo ortográfico, trajetória e faixa de varredura translúcida. Um esquema, sem escala orbital.','An orthographic globe, trajectory and translucent scanning swath. A diagram without orbital scale.')],
];
const pipeline=[['data',p('Ingestão','Ingestion'),p('Bases públicas, microdados e coleta de campo.','Public datasets, microdata and field collection.')],['layers',p('Normalização','Normalization'),p('Limpeza, harmonização e documentação das fontes.','Cleaning, harmonization and source documentation.')],['research',p('Modelagem','Modeling'),p('Estatística, análise territorial e cenários.','Statistics, territorial analysis and scenarios.')],['shield',p('Validação','Validation'),p('Verificação de qualidade, limites e incertezas.','Review of quality, limitations and uncertainty.')],['check',p('Decisão','Decision'),p('Indicadores, visualizações e recomendações.','Indicators, visualizations and recommendations.')]];
const architecture=[['SOURCE',p('Acervos e microdados','Archives and microdata'),p('Documentos, APIs e dados públicos','Documents, APIs and public data')],['EXTRACT',p('OCR e extração','OCR and extraction'),'Docling / Tesseract'],['INDEX',p('Chunks e embeddings','Chunks and embeddings'),'Qdrant / Milvus'],['CONNECT',p('Servidor MCP','MCP server'),p('Ferramentas e contratos de consulta','Query tools and contracts')],['DELIVER',p('Análise com fontes','Source-backed analysis'),p('LLMs, indicadores e evidências','LLMs, indicators and evidence')]];
const densityShapes=data.density.series.map((series,i)=>{const base=85+i*75;return {base,points:series.map((value,j)=>`${65+j*39},${base-value*50}`).join(' ')};});
const densityNames=[p('Transição','Transition'),'Cerrado',p('Mata Atlântica','Atlantic Forest')];
const radarNames=lang==='pt'?data.radar.dimensions:['Governance','Water','Biodiversity','Compliance','Land use','Carbon'];
const radarPoints=(values:readonly number[])=>values.map((value,i)=>{const angle=(i*60-90)*Math.PI/180;return`${170+Math.cos(angle)*value*1.02},${150+Math.sin(angle)*value*1.02}`;}).join(' ');
const radarLabels=radarNames.map((name,i)=>{const angle=(i*60-90)*Math.PI/180;return {name,x:170+Math.cos(angle)*132,y:153+Math.sin(angle)*132};});
const line=(key:'value'|'lower'|'upper')=>data.temporal.map((row,i)=>`${40+i*54},${210-(row[key]-50)*4}`).join(' ');
const area=[...data.temporal.map((row,i)=>`${40+i*54},${210-(row.upper-50)*4}`),...data.temporal.slice().reverse().map((row,i)=>`${40+(7-i)*54},${210-(row.lower-50)*4}`)].join(' ');
const signedColor=(value:number)=>{const base=value<0?[0,87,255]:[253,86,56];return '#'+base.map(channel=>Math.round(255+(channel-255)*Math.abs(value)).toString(16).padStart(2,'0')).join('');};
---
{part==='research'?<>
<section id="ilustracoes" class="ds-section ds-lab-section" aria-labelledby="illustration-title"><div class="ds-section-heading"><span class="eyebrow">02 / {p('ILUSTRAÇÃO CIENTÍFICA','SCIENTIFIC ILLUSTRATION')}</span><h2 id="illustration-title">{p('Ilustração e espectros multiespectrais.','Illustration and multispectral bands.')}</h2><p>{p('Abstrações técnicas com traços leves, superfícies neutras e acentos que comunicam uma função.','Technical abstractions with light strokes, neutral surfaces and accents that communicate a function.')}</p></div>
<div class="ds-illustration-grid">{illustrations.map(([name,code,title,copy])=><article class="ds-lab-card"><div class="ds-card-kicker mono"><span>{code}</span><span>SVG / VECTOR</span></div><div class="ds-illustration-stage"><img src={illustrationFile(name)} alt={illustrationLabels[name]||''} width="220" height="200" loading="lazy"/></div><h3>{title}</h3><p>{copy}</p><a class="text-link" href={illustrationFile(name)} download={`${name}.svg`}>{p('Baixar SVG','Download SVG')}<Fragment set:html={northeast}/></a></article>)}
<article class="ds-lab-card ds-spectral-card"><div class="ds-card-kicker mono"><span>06 / SPECTRAL</span><span>{p('SEMÂNTICA','SEMANTICS')}</span></div><div class="ds-spectral-list">{[[p('Vegetação / NDVI','Vegetation / NDVI'),'vegetation'],[p('Água / hidrologia','Water / hydrology'),'water'],[p('Temperatura / LST','Temperature / LST'),'thermal'],['Radar / SAR','radar']].map(([label,key])=><div><span class="ds-band" style={`--band:${data.spectral[key as keyof typeof data.spectral]}`} aria-hidden="true"></span><strong>{label}</strong><code>{data.spectral[key as keyof typeof data.spectral].toUpperCase()}</code></div>)}</div><h3>{p('Cores com significado.','Colors with meaning.')}</h3><p>{p('Uma convenção visual para camadas de análise. A cor não identifica o comprimento de onda físico; nomes e legendas sempre acompanham os dados.','A visual convention for analytical layers. Color does not identify a physical wavelength; names and legends always accompany the data.')}</p></article></div>
</section>
<section id="diagramas" class="ds-section ds-lab-section" aria-labelledby="diagram-title"><div class="ds-section-heading"><span class="eyebrow">03 / {p('ARQUITETURA E EVIDÊNCIAS','ARCHITECTURE AND EVIDENCE')}</span><h2 id="diagram-title">{p('Do dado à decisão.','From data to decisions.')}</h2><p>{p('Fluxos explícitos tornam origem, transformação, validação e entrega compreensíveis.','Explicit flows make origin, transformation, validation and delivery understandable.')}</p></div>
<div class="ds-lab-panel"><div class="ds-panel-heading"><h3>{p('Esteira de pesquisa territorial','Territorial research pipeline')}</h3><span class="ds-spec-label mono">5 {p('ETAPAS','STAGES')}</span></div><ol class="ds-pipeline">{pipeline.map(([name,title,copy],i)=><li><span class="mono">0{i+1} / {['INGEST','NORMALIZE','MODEL','REVIEW','ACTION'][i]}</span><span class="ds-pipeline-icon" set:html={icon(name)}/><h4>{title}</h4><p>{copy}</p></li>)}</ol><p class="ds-lab-note">{p('Esquema metodológico. Critérios de validação e auditoria são definidos em cada projeto.','Methodological diagram. Validation and audit criteria are defined for each project.')}</p></div>
<div class="ds-lab-panel"><div class="ds-panel-heading"><h3>{p('Do acervo em papel ao servidor MCP','From paper archives to the MCP server')}</h3><span class="ds-spec-label mono">OCR / EMBEDDINGS / MCP</span></div><ol class="ds-architecture">{architecture.map(([code,title,copy])=><li><span class="mono">{code}</span><h4>{title}</h4><p>{copy}</p></li>)}</ol><p class="ds-lab-note">{p('Arquitetura de referência. Rastreabilidade, permissões de acesso e avaliação dos modelos precisam acompanhar a integração.','Reference architecture. Traceability, access permissions and model evaluation must accompany the integration.')}</p></div>
</section>
<section id="dataviz" class="ds-section ds-lab-section" style={`--chart-canvas:${data.charts.canvas};--chart-coral:${data.charts.coral};--chart-emerald:${data.charts.emerald}`} aria-labelledby="dataviz-title"><div class="ds-section-heading"><span class="eyebrow">04 / {p('VISUALIZAÇÃO DE DADOS','DATA VISUALIZATION')}</span><h2 id="dataviz-title">{p('Dados legíveis. Contexto visível.','Readable data. Visible context.')}</h2><p>{p('Quatro padrões para relações, distribuições, evolução e múltiplas dimensões. Todos os valores abaixo são sintéticos.','Four patterns for relationships, distributions, change and multiple dimensions. All values below are synthetic.')}</p></div>
<div class="ds-dataviz-grid">
<figure class="ds-lab-card ds-chart"><div class="ds-panel-heading"><h3>{p('Matriz de correlação','Correlation matrix')}</h3><span class="ds-spec-label mono">HEATMAP / 6 × 6</span></div><div class="ds-heatmap-wrap"><table class="ds-heatmap"><caption class="sr-only">{p('Matriz sintética, valores entre −1 e +1.','Synthetic matrix, values between −1 and +1.')}</caption><thead><tr><th scope="col"><span class="sr-only">{p('Variável','Variable')}</span></th>{data.correlation.variables.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{data.correlation.values.map((row,i)=><tr><th scope="row">{data.correlation.variables[i]}</th>{row.map(value=><td style={`--cell:${signedColor(value)};--cell-ink:${contrastRatio('#181c22',signedColor(value))>=4.5?'#181c22':contrastRatio('#fff',signedColor(value))>=4.5?'#fff':'#000'}`}>{value.toFixed(2)}</td>)}</tr>)}</tbody></table></div><div class="ds-diverging-key mono"><span>−1.0 / BLUE</span><i aria-hidden="true"></i><span>+1.0 / CORAL</span></div><figcaption>{p('Valores didáticos, sem amostra observada ou teste de significância. Cada célula exibe o número além da cor.','Teaching values without an observed sample or significance test. Each cell displays its number as well as its color.')}</figcaption></figure>
<figure class="ds-lab-card ds-chart"><div class="ds-panel-heading"><h3>{p('Distribuições comparadas','Compared distributions')}</h3><span class="ds-spec-label mono">RIDGELINE</span></div><svg class="ds-data-svg" viewBox="0 0 500 290" aria-hidden="true"><g stroke="#dfe1ea"><path d="M65 240h390M65 160h390M65 80h390"/><path d="M65 40v200M260 40v200M455 40v200" stroke-dasharray="3 5"/></g>{densityShapes.map(({base,points},i)=><g><polygon points={`65,${base} ${points} 455,${base}`} fill={[data.charts.amber,data.charts.water,data.charts.coral][i]} fill-opacity={i===1?.2:.25}/><polyline points={points} fill="none" stroke={[data.charts.amber,data.charts.water,data.charts.coral][i]} stroke-width="1.7"/><text x="65" y={base+20}>{densityNames[i]}</text></g>)}<text x="65" y="275">0</text><text x="250" y="275">50</text><text x="430" y="275">100</text></svg><figcaption>{p('Densidades normalizadas fictícias em uma escala de 0 a 100. Não representam estoque de carbono ou uma estimativa de campo.','Fictional normalized densities on a 0–100 scale. They do not represent carbon stocks or a field estimate.')}</figcaption><details class="ds-data-details"><summary>{p('Ver valores da distribuição','View distribution values')}</summary><div class="ds-data-table"><table><thead><tr><th scope="col">{p('Índice','Index')}</th>{densityNames.map(name=><th scope="col">{name}</th>)}</tr></thead><tbody>{data.density.x.map((x,i)=><tr><th scope="row">{x}</th>{data.density.series.map(series=><td>{series[i].toFixed(2)}</td>)}</tr>)}</tbody></table></div></details></figure>
<figure class="ds-lab-card ds-chart"><div class="ds-panel-heading"><h3>{p('Evolução e faixa de incerteza','Change and uncertainty band')}</h3><span class="ds-spec-label mono">TIME SERIES</span></div><svg class="ds-data-svg" viewBox="0 0 500 290" aria-hidden="true"><g stroke="#dfe1ea"><path d="M40 50h378M40 130h378M40 210h378" stroke-dasharray="3 4"/></g><polygon points={area} fill={data.charts.coral} fill-opacity={data.charts.uncertaintyOpacity}/><polyline points={line('value')} fill="none" stroke={data.charts.coral} stroke-width="2.5"/>{data.temporal.map((row,i)=><g><circle cx={40+i*54} cy={210-(row.value-50)*4} r={i<4?3:i===data.temporal.length-1?4:3.5} fill={i<4?data.charts.graphite:data.charts.coral}/><text x={36+i*54} y="250">{row.period}</text></g>)}<text x="6" y="55">90</text><text x="6" y="135">70</text><text x="6" y="215">50</text><text x="180" y="278">{p('PERÍODO','PERIOD')}</text></svg><div class="ds-chart-legend ds-temporal-legend"><span><i class="ds-area-key" aria-hidden="true"></i>{p('Faixa ilustrativa (±4 pontos)','Illustrative band (±4 points)')}</span><span><i class="ds-line-key" aria-hidden="true"></i>{p('Série temporal','Time series')}</span></div><figcaption>{p('Indicador sintético com faixa de ±4 pontos. A faixa é uma ilustração, sem inferência de confiança estatística.','Synthetic indicator with a ±4-point band. The band is an illustration without statistical confidence inference.')}</figcaption><details class="ds-data-details"><summary>{p('Ver a série e os limites','View the series and bounds')}</summary><div class="ds-data-table"><table><thead><tr>{[p('Período','Period'),p('Indicador','Indicator'),p('Limite inferior','Lower bound'),p('Limite superior','Upper bound')].map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{data.temporal.map(row=><tr><th scope="row">{row.period}</th><td>{row.value}</td><td>{row.lower}</td><td>{row.upper}</td></tr>)}</tbody></table></div></details></figure>
<figure class="ds-lab-card ds-chart"><div class="ds-panel-heading"><h3>{p('Resiliência multidimensional','Multidimensional resilience')}</h3><span class="ds-spec-label mono">RADAR / 6D</span></div><svg class="ds-data-svg ds-radar-svg" viewBox="0 0 340 300" aria-hidden="true">{[25,50,75,100].map(value=><polygon points={radarPoints(Array(6).fill(value))} fill="none" stroke="#dfe1ea"/>)}{Array.from({length:6},(_,i)=><line x1="170" y1="150" x2={170+Math.cos((i*60-90)*Math.PI/180)*102} y2={150+Math.sin((i*60-90)*Math.PI/180)*102} stroke="#dfe1ea"/>)}<polygon points={radarPoints(data.radar.scenario)} fill={data.charts.emerald} fill-opacity={data.charts.radarScenarioOpacity} stroke={data.charts.emerald} stroke-width="2"/><polygon points={radarPoints(data.radar.baseline)} fill={data.charts.coral} fill-opacity={data.charts.radarBaselineOpacity} stroke={data.charts.coral} stroke-width="2" stroke-dasharray="5 4"/>{radarLabels.map(({name,x,y})=><text x={x} y={y} text-anchor="middle">{name}</text>)}</svg><div class="ds-chart-legend"><span><i class="ds-line-key ds-dashed"></i>{p('Linha de base','Baseline')}</span><span><i class="ds-line-key ds-green"></i>{p('Cenário ilustrativo','Illustrative scenario')}</span></div><figcaption>{p('Seis dimensões sintéticas de 0 a 100. Séries diferenciadas por traço e rótulos, além de cor.','Six synthetic dimensions from 0 to 100. Series distinguished by strokes and labels as well as color.')}</figcaption><details class="ds-data-details"><summary>{p('Ver valores por dimensão','View values by dimension')}</summary><div class="ds-data-table"><table><thead><tr><th scope="col">{p('Dimensão','Dimension')}</th><th scope="col">{p('Base','Baseline')}</th><th scope="col">{p('Cenário','Scenario')}</th></tr></thead><tbody>{radarNames.map((name,i)=><tr><th scope="row">{name}</th><td>{data.radar.baseline[i]}</td><td>{data.radar.scenario[i]}</td></tr>)}</tbody></table></div></details></figure>
</div><div class="ds-data-source"><p>{p('Fonte: fixtures sintéticas do design system. Escalas e unidades estão descritas em cada exemplo.','Source: synthetic design-system fixtures. Scales and units are described in each example.')}</p><a class="text-link" href={file('synthetic-data.csv')} download="serra-synthetic-data.csv">{p('Baixar dados dos exemplos','Download example data')}<Fragment set:html={arrow}/></a></div>
</section>
<section id="cartografia" class="ds-section ds-lab-section" aria-labelledby="maps-title"><div class="ds-section-heading"><span class="eyebrow">05 / {p('CARTOGRAFIA DIGITAL','DIGITAL CARTOGRAPHY')}</span><h2 id="maps-title">{p('Territórios em camadas.','Territories in layers.')}</h2><p>{p('Bases de baixo contraste, água em azul suave e polígonos com preenchimento translúcido.','Low-contrast basemaps, water in soft blue and polygons with translucent fills.')}</p></div>
<div class="ds-lab-panel ds-map-panel"><div class="ds-panel-heading"><h3>{p('Terminal cartográfico / demonstração','Cartographic terminal / demonstration')}</h3><span class="ds-spec-label mono">VECTOR / SYNTHETIC</span></div><div class="ds-map-toolbar" role="group" aria-label={p('Camadas do mapa demonstrativo','Demonstration map layers')}>{[['parcels',p('Territórios','Territories')],['water',p('Rede hídrica','Waterways')],['heat',p('Intensidade','Intensity')]].map(([layer,label])=><button type="button" data-map-layer={layer} aria-pressed="true" disabled><span aria-hidden="true" class={`ds-layer-dot ${layer}`}></span>{label}</button>)}</div>
<div class="ds-map-canvas"><svg viewBox="0 0 900 360" aria-hidden="true"><defs><pattern id="ds-map-grid" width="45" height="45" patternUnits="userSpaceOnUse"><path d="M45 0H0V45" fill="none" stroke="#dfe1ea" stroke-width=".6"/></pattern><radialGradient id="ds-map-heat"><stop stop-color="#fd5638" stop-opacity=".62"/><stop offset="1" stop-color="#fd5638" stop-opacity="0"/></radialGradient></defs><rect width="900" height="360" fill="#f4f5f8"/><g id="ds-map-features"><rect x="-400" y="-300" width="1700" height="1000" fill="url(#ds-map-grid)"/><g stroke="#e2e5ec" stroke-width="8" fill="none"><path d="M40 0 150 360M370 0 500 360M740 0 710 360M0 220 900 210"/></g><g data-map-feature="water"><path d="M-40 155C150 100 250 215 450 135S690 225 940 135" fill="none" stroke="#cad6e2" stroke-width="34"/><path d="M450 135 580 340" fill="none" stroke="#cad6e2" stroke-width="17"/></g><g data-map-feature="heat"><circle cx="245" cy="245" r="85" fill="url(#ds-map-heat)"/><circle cx="690" cy="176" r="120" fill="url(#ds-map-heat)"/></g><g data-map-feature="parcels" fill="#fd5638" fill-opacity=".12" stroke="#b83b24" stroke-width="1.5"><path d="M180 80 290 65 340 138 238 163 163 130Z"/><path d="M620 135 718 120 765 210 647 235 605 185Z"/></g><g fill="#2e2e2e"><circle cx="290" cy="100" r="4"/><circle cx="710" cy="190" r="4"/></g><g font-family="JetBrains Mono" font-size="11" fill="#494a4d"><text x="304" y="104">SAMPLE / A</text><text x="725" y="194">SAMPLE / B</text></g></g></svg><div class="ds-map-zoom"><button type="button" data-map-zoom="in" aria-label={p('Ampliar mapa demonstrativo','Zoom in on demonstration map')} disabled>+</button><button type="button" data-map-zoom="out" aria-label={p('Reduzir mapa demonstrativo','Zoom out on demonstration map')} disabled>−</button></div><span class="ds-map-scale mono">{p('ESQUEMA SEM ESCALA GEOGRÁFICA','DIAGRAM WITHOUT GEOGRAPHIC SCALE')}</span></div><p id="ds-map-status" class="ds-lab-note" role="status" aria-live="polite">{p('Mapa esquemático com territórios, rede hídrica e intensidade. Não contém localizações reais.','Schematic map with territories, waterways and intensity. It contains no real locations.')}</p><noscript><p class="ds-lab-note">{p('O mapa pode ser visto sem JavaScript; os controles de camadas e zoom exigem JavaScript.','The map can be viewed without JavaScript; layer and zoom controls require JavaScript.')}</p></noscript></div>
<div class="ds-two"><div class="ds-lab-panel ds-map-spec"><h3>Google Maps Platform</h3><p>{p('Estilo JSON para o modo de estilização legada. Uma integração real requer chave e configuração do Google; este exemplo não carrega a API.','JSON style for legacy styling mode. A real integration requires a Google key and configuration; this example does not load the API.')}</p><code>MapOptions.styles / WGS 84</code><a class="text-link" href={file('google-maps-style.json')} download="serra-google-maps-style.json">{p('Baixar estilo Google Maps','Download Google Maps style')}<Fragment set:html={arrow}/></a></div><div class="ds-lab-panel ds-map-spec"><h3>MapLibre GL</h3><p>{p('Style Specification v8 com camadas GeoJSON sintéticas, sem serviços externos. SIRGAS 2000 (EPSG:4674) exige transformação adequada para WGS 84 (EPSG:4326).','Style Specification v8 with synthetic GeoJSON layers and no external services. SIRGAS 2000 (EPSG:4674) requires proper transformation to WGS 84 (EPSG:4326).')}</p><code>version: 8 / GeoJSON</code><a class="text-link" href={file('maplibre-style.json')} download="serra-maplibre-style.json">{p('Baixar estilo MapLibre','Download MapLibre style')}<Fragment set:html={arrow}/></a></div></div>
</section>
</>:<section id="papelaria" class="ds-section ds-lab-section" aria-labelledby="print-title"><div class="ds-section-heading"><span class="eyebrow">07 / {p('APLICAÇÕES FÍSICAS','PHYSICAL APPLICATIONS')}</span><h2 id="print-title">{p('Identidade além da tela.','Identity beyond the screen.')}</h2><p>{p('Papelaria editorial, whitepapers e materiais de pesquisa com o logotipo que já identifica o site.','Editorial stationery, whitepapers and research materials with the logo that already identifies the site.')}</p></div>
<div class="ds-stationery" aria-label={p('Composição demonstrativa de papelaria Serra Research','Demonstration Serra Research stationery composition')}><div class="ds-print-sheet"><div class="wordmark">Serra <span>Research</span><i></i></div><span class="mono">{p('PESQUISA + ENGENHARIA','RESEARCH + ENGINEERING')}</span><div class="ds-letter-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><div class="ds-letter-footer mono">{email}</div></div><div class="ds-print-cover"><div class="wordmark">Serra <span>Research</span><i></i></div><div class="ds-print-cover-title">{p('Evidências para impacto.','Evidence for impact.')}</div><span class="mono">{p('CADERNO DE PESQUISA / EXEMPLO','RESEARCH NOTEBOOK / EXAMPLE')}</span></div><div class="ds-print-business"><div class="wordmark">Serra <span>Research</span><i></i></div><span>{p('Pesquisa aplicada e engenharia de dados','Applied research and data engineering')}</span><span class="mono">{email}</span></div></div>
