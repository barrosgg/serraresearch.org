---
import {serviceResearch,technologies,sources,licenses,type Bilingual} from '../lib/service-research';
import {getServices} from '../lib/landing';
import {icon,northeast,arrow} from '../lib/visuals';
import {pick,type Locale} from '../i18n';
const {lang}=Astro.props as {lang:Locale};
const p=(pt:string,en:string)=>pick(lang,pt,en);
const text=(value:Bilingual)=>value[lang==='pt'?0:1];
const services=getServices(lang);
---
{services.map((s,index)=>{
 const data=serviceResearch[index];
 const references=[...new Set(data.secondary.flatMap(group=>group.sources))];
 return <template data-service-template={index}>
  <header class="service-dialog-heading"><div class="service-dialog-kicker"><span class="service-icon" set:html={icon(s.icon)}/><span class="eyebrow">{s.code} / {p('ÁREA DE ATUAÇÃO','EXPERTISE')}</span></div><h2 id="dialog-title" tabindex="-1">{s.name}</h2><p class="service-dialog-lead">{s.full}</p><p class="service-scope">{text(data.scope)}{' '}{p('A seleção da stack considera os objetivos, o orçamento e os requisitos de proteção de dados de cada projeto.','Stack selection takes each project’s objectives, budget and data-protection requirements into account.')}</p></header>
  <section class="service-deliverables" aria-labelledby="service-support"><h3 id="service-support">{p('Como podemos apoiar','How we can help')}</h3><ul class="service-support-list">{s.items.map(item=><li><Fragment set:html={icon('check')}/><span>{item}</span></li>)}</ul></section>
  <div class="service-detail-grid">
   <section class="service-detail-section service-stack" aria-labelledby="service-stack-title"><div class="service-section-label mono">01 / STACK</div><h3 id="service-stack-title">{p('Tecnologias para cada desafio','Technology for each challenge')}</h3><div class="service-stack-grid">
    {(['open','proprietary'] as const).map(kind=><div class:list={['stack-group',kind]}><h4><span class="status-dot"></span>{kind==='open'?'Open source':p('Serviços proprietários / não open source','Proprietary / non-open-source services')}</h4><ul>{data[kind].map(key=>{const tech=technologies[key];return <li><a href={tech.url} target="_blank" rel="noopener noreferrer">{tech.name}<Fragment set:html={northeast}/><span class="sr-only">{p('(abre nova aba)','(opens in a new tab)')}</span></a><p>{text(tech.note)}</p>{kind==='open'&&licenses[key]&&<span class="tech-license mono">{licenses[key]}</span>}</li>})}</ul></div>)}
   </div><p class="service-footnote">{p('Licenças de código, modelos, dados e hospedagem são verificadas separadamente. SDKs abertos não tornam uma API ou um serviço de nuvem proprietário em open source.','Code, model, data and hosting licenses are checked separately. Open SDKs do not make proprietary APIs or cloud services open source.')}</p></section>
   <section class="service-detail-section" aria-labelledby="service-secondary-title"><div class="service-section-label mono">02 / {p('DADOS SECUNDÁRIOS','SECONDARY DATA')}</div><h3 id="service-secondary-title">{p('Fontes que já existem','Existing sources')}</h3>{data.secondary.map(group=><div class="secondary-group"><h4>{text(group.title)}</h4><p>{text(group.description)}</p><div class="source-tags">{group.sources.map(key=><a href={sources[key].url} target="_blank" rel="noopener noreferrer">{sources[key].name}<Fragment set:html={northeast}/><span class="sr-only">{p('(abre nova aba)','(opens in a new tab)')}</span></a>)}</div></div>)}</section>
   <section class="service-detail-section" aria-labelledby="service-primary-title"><div class="service-section-label mono">03 / {p('DADOS PRIMÁRIOS','PRIMARY DATA')}</div><h3 id="service-primary-title">{p('Evidência construída no projeto','Evidence developed in the project')}</h3><p class="service-category-intro">{p('Coletas e registros possíveis, definidos no desenho metodológico.','Possible collection activities and records, defined in the methodological design.')}</p><ul class="service-detail-list">{data.primary.map(item=><li>{text(item)}</li>)}</ul><p class="service-footnote">{p('A coleta exige finalidade, base legal, proteção dos participantes e controle de acesso. Consentimento e salvaguardas específicas são aplicados quando pertinentes.','Collection requires a purpose, legal basis, participant protection and access control. Consent and specific safeguards apply where appropriate.')}</p></section>
   <section class="service-detail-section" aria-labelledby="service-platforms-title"><div class="service-section-label mono">04 / {p('PLATAFORMAS E GESTÃO','PLATFORMS & MANAGEMENT')}</div><h3 id="service-platforms-title">{p('Tecnologia que torna o dado utilizável','Technology that makes data usable')}</h3><ul class="service-detail-list">{data.platforms.map(item=><li>{text(item)}</li>)}</ul></section>
   <section class="service-detail-section service-impact" aria-labelledby="service-impact-title"><div class="service-section-label mono">05 / {p('INFORMAÇÕES PARA IMPACTO','INFORMATION FOR IMPACT')}</div><h3 id="service-impact-title">{p('O que pode orientar decisões','What can guide decisions')}</h3><ul class="service-detail-list">{data.outputs.map(item=><li>{text(item)}</li>)}</ul></section>
  </div>
  <aside class="service-quality"><span class="service-quality-icon" set:html={icon('shield')}/><div><h3>{p('Rigor, contexto e limites','Rigor, context and limitations')}</h3><p>{text(data.quality)}</p></div></aside>
  <details class="service-references"><summary>{p('Fontes e documentação das bases','Dataset sources and documentation')} <span class="mono">{String(references.length).padStart(2,'0')}</span></summary><div class="reference-grid">{references.map(key=><div><a href={sources[key].url} target="_blank" rel="noopener noreferrer">{sources[key].name}<Fragment set:html={northeast}/><span class="sr-only">{p('(abre nova aba)','(opens in a new tab)')}</span></a><p>{text(sources[key].description)}</p></div>)}</div><p class="service-footnote">{p('Referências organizadas em 10/10/2026. Links direcionam aos responsáveis pelas bases; disponibilidade, anonimização e condições de acesso podem mudar.','References compiled on 10 October 2026. Links point to dataset providers; availability, anonymization and access conditions may change.')}</p></details>
  <div class="service-dialog-contact"><div><span class="eyebrow">{p('DO CONTEXTO À SOLUÇÃO','FROM CONTEXT TO SOLUTION')}</span><p>{p('Vamos definir as fontes, a coleta e as entregas do seu projeto.','Let’s define your project’s sources, collection and deliverables.')}</p></div><a id="dialog-contact" class="button" href="#contato">{p('Converse sobre seu projeto','Discuss your project')}<Fragment set:html={arrow}/></a></div>
 </template>
})}
