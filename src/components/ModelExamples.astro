---
import {pick,type Locale} from '../i18n';
import {path,email} from '../lib/site';
import {icon,arrow} from '../lib/visuals';
const {lang,part='content'}=Astro.props as {lang:Locale;part?:'content'|'identity'|'print'};
const p=(pt:string,en:string)=>pick(lang,pt,en);
const download=(name:string)=>path(`design/print/${name}`).replace(/\/$/,'');
---
{part==='identity'?<div class="ds-lab-panel ds-logo-spec" id="model-logo-construction"><h3>{p('Construção da assinatura atual','Existing wordmark construction')}</h3><div class="ds-logo-measure"><div class="wordmark">Serra <span>Research</span><i></i></div><span class="mono">SPACE GROTESK / 600 + 400</span></div><div class="ds-model-specs"><span>24 px / {p('tamanho-base','base size')}</span><span>−1.2 px / {p('entreletras','tracking')}</span><span>6 px / {p('intervalo','gap')}</span><span>5 px / {p('ponto coral','coral dot')}</span></div><p>{p('Diagrama do componente existente. A marca alternativa e as cotas do arquivo de referência não substituem esta assinatura.','Diagram of the existing component. The reference file’s alternative mark and measurements do not replace this wordmark.')}</p></div>:part==='print'?<div class="ds-two ds-model-print" id="model-print-covers"><article class="ds-lab-card"><div class="ds-notebook"><div class="wordmark">Serra <span>Research</span><i></i></div><span class="mono">WHITEPAPER / {p('MODELO','TEMPLATE')}</span><h4>{p('Caderno de pesquisa','Research notebook')}</h4><p>{p('[Título, autoria, data e versão]','[Title, authors, date and version]')}</p></div><h4>{p('Caderno técnico e capa editorial','Technical notebook and editorial cover')}</h4><a class="text-link" href={download('whitepaper-cover.svg')} download>{p('Baixar capa SVG','Download cover SVG')}<Fragment set:html={arrow}/></a></article><article class="ds-lab-card"><div class="ds-folder"><div class="wordmark">Serra <span>Research</span><i></i></div><span class="mono">RESEARCH / DATA / IMPACT</span><div class="ds-folder-pocket" aria-hidden="true"></div></div><h4>{p('Pasta de entrega com bolso interno','Delivery folder with internal pocket')}</h4><p>{p('Modelo visual; dobra, lombada e faca são definidos na produção.','Visual template; folds, spine and die are specified in production.')}</p><a class="text-link" href={download('research-folder.svg')} download>{p('Baixar pasta SVG','Download folder SVG')}<Fragment set:html={arrow}/></a></article></div>:<div class="ds-model-catalog" id="model-editorial-patterns">
 <div class="ds-section-heading"><h3>{p('Padrões complementares dos modelos','Additional reference patterns')}</h3><p>{p('Exemplos para desenvolvimento. Números, pessoas, organizações e depoimentos abaixo não representam resultados ou credenciais da Serra Research.','Development examples. Numbers, people, organizations and testimonials below do not represent Serra Research results or credentials.')}</p></div>
 <div class="ds-two">
  <article class="ds-lab-card" id="model-impact-card"><span class="eyebrow">{p('RESULTADOS / DADOS SINTÉTICOS','RESULTS / SYNTHETIC DATA')}</span><h3>{p('Indicadores de resultado e impacto','Outcome and impact indicators')}</h3><div class="ds-example-metrics"><div><strong>+12%</strong><span>{p('Variação ilustrativa','Illustrative change')}</span></div><div><strong>240</strong><span>{p('Observações fictícias','Fictional observations')}</span></div></div><p>{p('Apresentar baseline, período, unidade, fonte e limites ao substituir por dados reais.','Provide a baseline, period, unit, source and limitations when replacing with real data.')}</p><div class="tags"><span>BASELINE</span><span>{p('MÉTODO','METHOD')}</span><span>{p('FONTE','SOURCE')}</span></div></article>
  <article class="ds-lab-card" id="model-team-card"><span class="eyebrow">{p('EQUIPE / CAMPOS EDITÁVEIS','TEAM / EDITABLE FIELDS')}</span><div class="ds-example-person"><span class="ds-person-avatar" aria-hidden="true" set:html={icon('research')}/><div><h3>{p('[Nome da pessoa]','[Person’s name]')}</h3><p>{p('[Função e formação verificadas]','[Verified role and qualifications]')}</p></div></div><dl class="ds-model-fields"><div><dt>ORCID</dt><dd>{p('[Identificador confirmado]','[Confirmed identifier]')}</dd></div><div><dt>{p('Áreas','Areas')}</dt><dd>{p('[Temas e publicações]','[Topics and publications]')}</dd></div></dl></article>
  <article class="ds-lab-card" id="model-testimonial"><span class="eyebrow">{p('DEPOIMENTO / MODELO','TESTIMONIAL / TEMPLATE')}</span><h3>{p('Validação por quem acompanha o projeto','Validation from project participants')}</h3><blockquote><p>{p('“[Inserir um depoimento autorizado, com contexto e atribuição.]”','“[Insert an authorized testimonial with context and attribution.]”')}</p><p class="ds-quote-attribution">{p('[Nome, função, organização e data]','[Name, role, organization and date]')}</p></blockquote><p>{p('O componente está pronto; nenhum cliente ou depoimento real é presumido.','The component is ready; no real client or testimonial is assumed.')}</p></article>
  <article class="ds-lab-card" id="model-partners"><span class="eyebrow">{p('ORGANIZAÇÕES / MODELO','ORGANIZATIONS / TEMPLATE')}</span><h3>{p('Faixa de organizações parceiras','Partner organization strip')}</h3><div class="ds-partner-placeholders"><span>{p('[Organização A]','[Organization A]')}</span><span>{p('[Organização B]','[Organization B]')}</span><span>{p('[Organização C]','[Organization C]')}</span></div><p>{p('Substituir somente por marcas e vínculos autorizados.','Replace only with authorized marks and relationships.')}</p></article>
  <article class="ds-lab-card" id="model-technical-validation"><span class="eyebrow">{p('OPERAÇÕES / REFERÊNCIA','OPERATIONS / REFERENCE')}</span><h3>{p('Validação em múltiplas camadas','Validation across multiple layers')}</h3><ol class="ds-list"><li>{p('Coleta em campo: amostras, entrevistas e observações com protocolo.','Field collection: samples, interviews and observations with a protocol.')}</li><li>{p('Sensoriamento: calibração, imagens e metadados espaciais.','Sensing: calibration, imagery and spatial metadata.')}</li><li>{p('Processamento: qualidade, reprodutibilidade e limites documentados.','Processing: documented quality, reproducibility and limitations.')}</li></ol><div class="tags"><span>GIS</span><span>LiDAR</span><span>GeoAI</span></div></article>
  <article class="ds-lab-card" id="model-briefing"><span class="eyebrow">{p('BRIEFING / ESPECIFICAÇÃO','BRIEFING / SPECIFICATION')}</span><h3>{p('Escopo e dados do projeto','Project scope and data')}</h3><fieldset><legend>{p('Tipo de demanda — exemplo','Request type — example')}</legend><label><input type="radio" name="ds-project-type" checked/> {p('Pesquisa e modelagem','Research and modeling')}</label><label><input type="radio" name="ds-project-type"/> {p('Engenharia de dados','Data engineering')}</label></fieldset><label class="ds-example-label">{p('Território / unidade de análise','Territory / unit of analysis')}<input placeholder={p('[Município, escola, bacia ou população]','[Municipality, school, basin or population]')}/></label><label class="ds-example-label">{p('Dados disponíveis','Available data')}<textarea rows="2" placeholder={p('[Bases, formatos e limitações]','[Sources, formats and limitations]')}></textarea></label><p>{p('Amostra sem envio ou armazenamento. O contato do site prepara um e-mail; anexos são adicionados no aplicativo de e-mail.','Sample without submission or storage. The site contact prepares an email; attachments are added in the email application.')}</p></article>
  <article class="ds-lab-card" id="model-open-science"><span class="eyebrow">OPEN SCIENCE / {p('RECURSOS','RESOURCES')}</span><h3>{p('Dados, código e reprodutibilidade','Data, code and reproducibility')}</h3><ul class="ds-list"><li>{p('Repositório: código, licença e versão de lançamento.','Repository: code, license and release version.')}</li><li>{p('Dataset: origem, dicionário e restrições de acesso.','Dataset: provenance, dictionary and access restrictions.')}</li><li>{p('Material suplementar: métodos, protocolos e resultados completos.','Supplementary material: methods, protocols and full results.')}</li></ul><a class="text-link" href={path('design/synthetic-data.csv').replace(/\/$/,'')} download>{p('Baixar dataset demonstrativo','Download demonstration dataset')}<Fragment set:html={arrow}/></a></article>
  <article class="ds-lab-card" id="model-faq"><span class="eyebrow">{p('PERGUNTAS FREQUENTES','FREQUENTLY ASKED QUESTIONS')}</span><h3>{p('Antes de começar','Before starting')}</h3><details class="ds-model-disclosure"><summary>{p('Como definir escopo e prazo?','How are scope and timing defined?')}</summary><p>{p('A partir do objetivo, fontes, requisitos de coleta, entregas e critérios de validação acordados para cada projeto.','From the objective, sources, collection requirements, deliverables and validation criteria agreed for each project.')}</p></details><details class="ds-model-disclosure"><summary>{p('Como compartilhar documentos?','How can documents be shared?')}</summary><p>{p('Comece pelo contato por e-mail. O canal de transferência e as permissões são combinados conforme o contexto dos dados.','Start with email contact. Transfer channels and permissions are agreed according to the data context.')}</p></details></article>
 </div>
 <div class="ds-lab-panel ds-briefing-callout" id="model-newsletter"><div><span class="eyebrow">{p('BRIEFINGS / INTERESSE VOLUNTÁRIO','BRIEFINGS / VOLUNTARY INTEREST')}</span><h3>{p('Receber notícias de pesquisa','Receive research news')}</h3><p>{p('Modelo de convite por e-mail. Não há inscrição automática, armazenamento de contatos ou serviço de newsletter ativo.','Email invitation template. There is no automatic signup, contact storage or active newsletter service.')}</p></div><a class="button" href={`mailto:${email}?subject=${encodeURIComponent(p('Interesse em briefings de pesquisa','Interest in research briefings'))}`}>{p('Manifestar interesse','Express interest')}<Fragment set:html={arrow}/></a></div>
</div>}
