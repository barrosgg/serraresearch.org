---
import {pick,type Locale} from '../i18n';
import {link} from '../lib/site';
const {lang}=Astro.props as {lang:Locale};
const p=(pt:string,en:string)=>pick(lang,pt,en);
---
<dialog id="accessibility-dialog" aria-labelledby="accessibility-title" class="preferences-dialog">
 <button class="dialog-close" data-close aria-label={p('Fechar','Close')}>×</button>
 <span class="eyebrow">{p('UMA EXPERIÊNCIA PARA TODOS','AN EXPERIENCE FOR EVERYONE')}</span><h2 id="accessibility-title">{p('Acessibilidade','Accessibility')}</h2><p>{p('Adapte a leitura. Suas preferências ficam somente neste navegador.','Adjust your reading experience. Your preferences stay in this browser only.')}</p>
 <label class="preference-row" for="text-size"><span>{p('Tamanho do texto','Text size')}</span><output id="text-size-value" for="text-size">100%</output><input id="text-size" type="range" min="100" max="130" step="10" value="100" /></label>
 <label class="preference-row"><span>{p('Aumentar contraste','Increase contrast')}</span><input id="high-contrast" type="checkbox" /></label>
 <label class="preference-row"><span>{p('Reduzir movimento','Reduce motion')}</span><input id="reduce-motion" type="checkbox" /><small>{p('A preferência do seu sistema também é respeitada.','Your system preference is also respected.')}</small></label>
 <button id="reset-preferences" class="text-link">{p('Restaurar padrão','Reset defaults')} ↺</button><p class="settings-status" role="status"></p>
 <a class="text-link" href={link('accessibility',lang)}>{p('Leia nossa declaração','Read our accessibility statement')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</dialog>
<dialog id="privacy-dialog" aria-labelledby="privacy-title" class="preferences-dialog">
 <button class="dialog-close" data-close aria-label={p('Fechar','Close')}>×</button><span class="eyebrow">{p('PRIVACIDADE POR PADRÃO','PRIVACY BY DEFAULT')}</span><h2 id="privacy-title">{p('Suas preferências','Your preferences')}</h2>
 <p>{p('Não usamos cookies de publicidade, analytics ou rastreamento. Nenhum serviço opcional é carregado nesta versão.','We do not use advertising, analytics or tracking cookies. This version loads no optional services.')}</p>
 <div class="privacy-category"><strong>{p('Armazenamento de preferências','Preference storage')}</strong><span>{p('Somente no navegador','Browser only')}</span><p>{p('Quando você ajusta a acessibilidade ou dispensa o aviso, salvamos essas escolhas localmente. Não são enviadas à Serra Research.','When you adjust accessibility or dismiss the notice, we save those choices locally. They are not sent to Serra Research.')}</p></div>
 <button id="clear-local-data" class="button">{p('Apagar preferências salvas','Delete saved preferences')}</button><p id="privacy-status" role="status"></p><a class="text-link" href={link('cookies',lang)}>{p('Entenda cookies e armazenamento','About cookies and storage')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</dialog>
<div id="privacy-notice" class="privacy-notice" role="region" aria-label={p('Aviso de privacidade','Privacy notice')} hidden><div><span class="eyebrow">{p('SUA PRIVACIDADE, RESPEITADA','YOUR PRIVACY, RESPECTED')}</span><p>{p('Sem cookies de rastreamento. Usamos armazenamento local apenas para suas preferências.','No tracking cookies. We use local storage only for your preferences.')}</p><a href={link('cookies',lang)}>{p('Saiba mais','Learn more')} <svg class="inline-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><button id="dismiss-notice" aria-label={p('Entendi, fechar aviso','Got it, dismiss notice')}>×</button></div>
