---
import Base from '../layouts/Base.astro';
import '../research-library.css';
import {pick,type Locale} from '../i18n';
import {link} from '../lib/site';
import {arrow,northeast} from '../lib/visuals';
const {lang}=Astro.props as {lang:Locale};const p=(pt:string,en:string)=>pick(lang,pt,en);
const types=lang==='pt'?['Whitepaper','Relatório','Nota técnica','Artigo de conferência','Artigo de periódico','Artigo de workshop','Preprint']:['Whitepaper','Research report','Technical note','Conference paper','Journal article','Workshop paper','Preprint'];
const fields:[string,string,'text'|'date',boolean][]=[['title',p('Título','Title'),'text',true],['description',p('Descrição para busca e compartilhamento (até 180 caracteres)','Search and sharing description (up to 180 characters)'),'text',true],['slug',p('Endereço da publicação (palavras separadas por hífen)','Publication address (hyphen-separated words)'),'text',true],['translationKey',p('Identificador comum às traduções','Shared translation identifier'),'text',true],['date',p('Data da publicação','Publication date'),'date',true],['tags',p('Temas, separados por vírgula (primeiro tema define o filtro)','Comma-separated topics (first topic defines the filter)'),'text',true]];
---
<Base lang={lang} title={p('Preparar publicação — Serra Research','Prepare a publication — Serra Research')} description={p('Editor local para preparar metadados e texto de pesquisas.','Local editor for preparing research metadata and text.')} alternate={link('editor',lang==='pt'?'en':'pt')} noindex={true}>
<main id="conteudo" tabindex="-1" class="document-main library-main"><div class="container publication-editor">
<a class="text-link" href={link('publications',lang)}>← {p('Voltar ao acervo','Back to the collection')}</a>
<header class="editor-heading"><span class="eyebrow">{p('FLUXO EDITORIAL / PESQUISA ABERTA','EDITORIAL WORKFLOW / OPEN RESEARCH')}</span><h1>{p('Prepare sua publicação.','Prepare your publication.')}</h1><p>{p('Organize autoria, metadados e texto em um arquivo pronto para revisão. Os dados ficam nesta aba; nada é enviado ou salvo automaticamente.','Organize authorship, metadata and text in a file ready for review. Data stays in this tab; nothing is sent or saved automatically.')}</p></header>
<aside class="editor-workflow"><strong>{p('Como publicar','How to publish')}</strong><p>{p('1. Preencha e baixe o Markdown. 2. Adicione o arquivo a src/content/publications/ no repositório. 3. Revise o conteúdo e altere draft para false. 4. Envie a alteração ao GitHub: o Astro gera a página e o GitHub Pages a publica. Esta tela não publica diretamente.','1. Complete and download the Markdown. 2. Add the file to src/content/publications/ in the repository. 3. Review the content and set draft to false. 4. Push the change to GitHub: Astro builds the page and GitHub Pages publishes it. This screen does not publish directly.')}</p><a class="text-link" href={link('template',lang)}>{p('Consultar o template científico','Explore the scientific template')}<Fragment set:html={northeast}/></a></aside>
<form id="publication-editor" data-language={lang}>
<fieldset><legend>{p('01 / Identificação e autoria','01 / Identity and authorship')}</legend><div class="editor-fields">{fields.map(([name,label,type,required])=><label>{label}<input name={name} type={type} required={required} maxlength={name==='description'?180:undefined} pattern={name==='slug'?'[a-z0-9]+(-[a-z0-9]+)*':undefined}/></label>)}<label>{p('Idioma do texto','Text language')}<select name="language"><option value="pt" selected={lang==='pt'}>Português</option><option value="en" selected={lang==='en'}>English</option></select></label><label>{p('Tipo de publicação','Publication type')}<select name="type">{types.map(type=><option>{type}</option>)}</select></label></div><label>{p('Autores — uma pessoa por linha: nome | instituição | ORCID (opcional)','Authors — one person per line: name | institution | ORCID (optional)')}<textarea name="authors" rows="3" required placeholder={p('Nome da pessoa | Instituição','Author name | Institution')}/></label><label>{p('Resumo científico','Scientific abstract')}<textarea name="abstract" rows="5" required/></label></fieldset>
<fieldset><legend>{p('02 / Publicação e transparência','02 / Publication and transparency')}</legend><div class="editor-fields"><label>{p('Veículo, evento ou série (opcional)','Venue, event or series (optional)')}<input name="venue"/></label><label>{p('Categoria do veículo','Venue category')}<select name="venueKind"><option value="series">{p('Série','Series')}</option><option value="conference">{p('Conferência','Conference')}</option><option value="journal">{p('Periódico','Journal')}</option><option value="workshop">Workshop</option><option value="institution">{p('Instituição','Institution')}</option></select></label><label>{p('Situação editorial','Publication status')}<select name="publicationStatus"><option value="working-paper">{p('Documento de trabalho','Working paper')}</option><option value="preprint">Preprint</option><option value="accepted">{p('Aceito','Accepted')}</option><option value="published">{p('Publicado','Published')}</option></select></label><label>{p('Revisão','Review')}<select name="reviewStatus"><option value="not-peer-reviewed">{p('Sem revisão por pares','Not peer-reviewed')}</option><option value="editorial-review">{p('Revisão editorial','Editorial review')}</option><option value="peer-reviewed">{p('Revisão por pares','Peer-reviewed')}</option></select></label>{[['doi','DOI'],['pdf',p('PDF: URL HTTPS ou caminho /publications/','PDF: HTTPS URL or /publications/ path')],['publicationUrl',p('Link da publicação original (HTTPS)','Original publication link (HTTPS)')],['version',p('Versão','Version')],['reportNumber',p('Número do relatório','Report number')],['license',p('Licença','License')]].map(([name,label])=><label>{label}<input name={name}/></label>)}</div>{[['funding',p('Financiamento — uma fonte por linha','Funding — one source per line')],['conflicts',p('Conflitos de interesse','Conflicts of interest')],['ethics',p('Ética e proteção das pessoas participantes','Ethics and participant protection')],['dataAvailability',p('Disponibilidade dos dados','Data availability')]].map(([name,label])=><label>{label}<textarea name={name} rows="2"/></label>)}<label>{p('Recursos — um por linha: tipo | título | URL (HTTPS ou /publications/)','Resources — one per line: kind | title | URL (HTTPS or /publications/)')}<textarea name="resources" rows="3" placeholder="dataset | Dados / Data | https://…"/><small>{p('Tipos aceitos: code, dataset, supplement, slides, video, project, preprint.','Accepted kinds: code, dataset, supplement, slides, video, project, preprint.')}</small></label></fieldset>
<fieldset><legend>{p('03 / Texto e revisão','03 / Text and review')}</legend><label>{p('Texto em Markdown','Markdown text')}<textarea name="body" rows="14" required placeholder="## Contexto / Context&#10;&#10;## Metodologia / Methods&#10;&#10;## Resultados / Results&#10;&#10;## Limitações / Limitations&#10;&#10;## Referências / References"/></label><div class="editor-options"><label><input type="checkbox" name="demo"/>{p('Exemplo fictício para desenvolvimento (endereço ganha prefixo demo-)','Fictional development example (address receives demo- prefix)')}</label><label><input type="checkbox" name="featured"/>{p('Destacar na biblioteca','Feature in the library')}</label></div><p>{p('O arquivo sempre começa como rascunho. Declare revisão por pares, DOI e resultados apenas quando forem verificáveis.','The file always starts as a draft. Declare peer review, DOI and results only when verifiable.')}</p></fieldset>
<div class="editor-actions"><button type="submit" class="button button-blue" disabled>{p('Gerar Markdown para revisão','Generate Markdown for review')}<Fragment set:html={arrow}/></button><button type="button" id="download-publication" class="button" disabled>{p('Baixar arquivo','Download file')}<Fragment set:html={arrow}/></button></div><p id="editor-status" role="status" aria-live="polite" aria-atomic="true"/>
</form><section class="editor-output" aria-labelledby="editor-output-title"><h2 id="editor-output-title">{p('Arquivo para revisão','File for review')}</h2><label for="editor-markdown">{p('Conteúdo gerado (somente leitura)','Generated content (read-only)')}</label><textarea id="editor-markdown" readonly rows="16" spellcheck="false"/><p>{p('Confira os metadados e o texto antes de inserir no repositório. Campos opcionais vazios são omitidos.','Check metadata and text before adding the file to the repository. Empty optional fields are omitted.')}</p></section>
<noscript><p>{p('O editor exige JavaScript. Você pode usar o template Markdown disponível no repositório.','The editor requires JavaScript. You can use the Markdown template available in the repository.')}</p></noscript>
</div></main></Base>
<script>import '../scripts/publication-editor';</script>
