---
import Base from '../layouts/Base.astro';
import '../design-system.css';
import {pick,type Locale} from '../i18n';
import {home,link,path} from '../lib/site';
import {getServices} from '../lib/landing';
import {icon,arrow,northeast} from '../lib/visuals';
import {designTokens as tokens,colorEntries,contrastPairs,contrastRatio} from '../lib/design-system';
const {lang}=Astro.props as {lang:Locale};
const p=(pt:string,en:string)=>pick(lang,pt,en);
const chapters=[['identidade','Identidade e princípios','Identity and principles'],['cores','Cores e contraste','Color and contrast'],['tipografia','Tipografia','Typography'],['layout','Layout e espaçamento','Layout and spacing'],['formas','Formas e superfícies','Shapes and surfaces'],['botoes','Botões e estados','Buttons and states'],['componentes','Cards e conteúdo','Cards and content'],['formularios','Formulários','Forms'],['icones','Ícones e gráficos','Icons and graphics'],['interacao','Navegação e interação','Navigation and interaction'],['acessibilidade','Acessibilidade','Accessibility'],['implementacao','Implementação e manutenção','Implementation and maintenance']];
const title=p('Design system','Design system');
const description=p('Guia visual da Serra Research: identidade, cores, tipografia, componentes, interação e acessibilidade, com exemplos e tokens para download.','Serra Research visual guide: identity, colors, typography, components, interaction and accessibility, with examples and downloadable tokens.');
const icons=['radar','data','globe','research','check','shield','layers','code'];
const iconLabels=[p('Radar','Radar'),p('Dados','Data'),p('Território','Territory'),p('Pesquisa','Research'),p('Validação','Validation'),p('Proteção','Protection'),p('Camadas','Layers'),p('Código','Code')];
---
<Base lang={lang} title={`${title} — Serra Research`} description={description} alternate={link('designSystem',lang==='pt'?'en':'pt')}>
 <main id="conteudo" tabindex="-1" class="ds-main">
  <div class="container">
   <a class="text-link" href={home(lang)}>← {p('Página inicial','Home')}</a>
   <header class="ds-hero">
    <div><div class="eyebrow"><span class="status-dot"></span>SERRA / {p('LINGUAGEM VISUAL','VISUAL LANGUAGE')}</div><h1>Design <span>system.</span></h1><p>{p('Clareza para comunicar. Consistência para construir.','Clarity to communicate. Consistency to build.')}</p><p class="ds-intro">{p('A documentação da interface da Serra Research, dos fundamentos visuais aos componentes que conectam pesquisa, dados e impacto social.','Documentation of the Serra Research interface, from visual foundations to components connecting research, data and social impact.')}</p><a class="button button-blue" href={path('design-tokens.json').replace(/\/$/,'')} download="serra-design-tokens.json">{p('Baixar tokens JSON','Download JSON tokens')}<Fragment set:html={arrow}/></a></div>
    <div class="ds-cover" aria-hidden="true"><div class="mono">SERRA / RESEARCH LAB</div><div class="ds-cover-orb"></div><div class="ds-cover-rule"></div><div class="ds-cover-type">Aa<span>01 — 12</span></div><div class="ds-cover-palette"><i></i><i></i><i></i><i></i></div></div>
   </header>
   <div class="ds-edition mono">{p('DOCUMENTAÇÃO DA INTERFACE ATUAL','CURRENT INTERFACE DOCUMENTATION')} / 10.10.2026 · ASTRO</div>
   <nav class="ds-toc" aria-label={p('Sumário do design system','Design system contents')}><strong class="mono">{p('NESTA PÁGINA','ON THIS PAGE')}</strong>{chapters.map(([id,pt,en],i)=><a href={`#${id}`}><span class="mono">{String(i+1).padStart(2,'0')}</span>{p(pt,en)}<span aria-hidden="true" set:html={northeast}/></a>)}</nav>

   <section id="identidade" class="ds-section" aria-labelledby="identity-title"><div class="ds-section-heading"><span class="eyebrow">01 / {p('FUNDAMENTOS','FOUNDATIONS')}</span><h2 id="identity-title">{p('Ciência com uma linguagem humana.','Science with a human voice.')}</h2><p>{p('Editorial, técnica e acolhedora. A interface transforma complexidade em uma leitura organizada, com espaço para contexto e evidências.','Editorial, technical and welcoming. The interface turns complexity into organized reading, with space for context and evidence.')}</p></div>
    <div class="ds-two"><div class="ds-panel ds-brand"><a class="wordmark" href={home(lang)}>Serra <span>Research</span><i></i></a><span class="mono">{p('MARCA EM FUNDO CLARO','MARK ON A LIGHT BACKGROUND')}</span></div><div class="ds-panel ds-brand ds-dark"><a class="wordmark" href={home(lang)}>Serra <span>Research</span><i></i></a><span class="mono">{p('MARCA EM FUNDO ESCURO','MARK ON A DARK BACKGROUND')}</span></div></div>
    <div class="ds-three ds-principles">{[[p('Clareza','Clarity'),p('Títulos diretos, texto legível e hierarquia que ajuda a encontrar informação.','Direct headings, readable copy and a hierarchy that helps people find information.')],[p('Rigor','Rigor'),p('Fontes, unidades e limites acompanham dados e resultados.','Sources, units and limitations accompany data and findings.')],[p('Responsabilidade','Responsibility'),p('Interações acessíveis, privacidade e representação cuidadosa dos territórios.','Accessible interactions, privacy and careful representation of communities.')]].map(([heading,copy])=><article><h3>{heading}</h3><p>{copy}</p></article>)}</div>
    <p class="ds-note">{p('O wordmark combina Serra em peso 600, Research em peso 400 e um ponto coral. Preserve a ordem, o alinhamento e a legibilidade; use o nome completo em textos institucionais.','The wordmark combines Serra at weight 600, Research at weight 400 and a coral dot. Preserve order, alignment and readability; use the full name in institutional text.')}</p>
   </section>

   <section id="cores" class="ds-section" aria-labelledby="colors-title"><div class="ds-section-heading"><span class="eyebrow">02 / {p('PALETA','PALETTE')}</span><h2 id="colors-title">{p('Coral para ação. Azul para inteligência.','Coral for action. Blue for intelligence.')}</h2><p>{p('Fundos neutros sustentam a leitura. O coral claro destaca ações; o azul organiza dados, links e contexto técnico.','Neutral backgrounds support reading. Light coral highlights actions; blue organizes data, links and technical context.')}</p></div>
    <div class="ds-swatches">{colorEntries.map(([key,variable,pt,en])=><article class="ds-swatch"><div class="ds-color" style={`--swatch:${tokens.colors[key]}`} aria-hidden="true"></div><div><h3>{p(pt,en)}</h3><code>{tokens.colors[key].toUpperCase()}</code><span class="mono">{variable}</span></div></article>)}</div>
    <h3 class="ds-subtitle">{p('Combinações de contraste','Contrast combinations')}</h3><div class="ds-table-wrap"><table><caption>{p('Contraste WCAG calculado para cores opacas, no modo padrão.','Calculated WCAG contrast for opaque colors in the default mode.')}</caption><thead><tr><th scope="col">{p('Uso','Use')}</th><th scope="col">{p('Texto / fundo','Text / background')}</th><th scope="col">{p('Razão','Ratio')}</th><th scope="col">{p('Aplicação','Application')}</th></tr></thead><tbody>{contrastPairs.map(pair=><tr><th scope="row">{p(pair.label[0],pair.label[1])}</th><td><code>{pair.foreground} / {pair.background}</code></td><td>{contrastRatio(pair.foreground,pair.background).toFixed(2)}:1</td><td>{pair.large?p('Título grande · mínimo 3:1','Large heading · minimum 3:1'):p('Texto normal · mínimo 4,5:1','Normal text · minimum 4.5:1')}</td></tr>)}</tbody></table></div>
    <p class="ds-note">{p('O coral da marca (#FD5638) é usado em elementos gráficos. Para textos menores, use o coral escuro; no botão coral claro, use texto escuro. Transmita estados também por texto, forma ou ícone.','Brand coral (#FD5638) is used in graphics. Use darker coral for smaller text and dark text on the light coral button. Also convey states through text, shape or icons.')}</p>
   </section>

   <section id="tipografia" class="ds-section" aria-labelledby="type-title"><div class="ds-section-heading"><span class="eyebrow">03 / {p('TIPOGRAFIA','TYPOGRAPHY')}</span><h2 id="type-title">{p('Expressiva nos títulos. Precisa nos detalhes.','Expressive headings. Precise details.')}</h2><p>{p('Space Grotesk para títulos, corpo e ações. JetBrains Mono para índices, metadados e rótulos técnicos. As fontes são hospedadas no próprio site.','Space Grotesk for headings, body copy and actions. JetBrains Mono for indexes, metadata and technical labels. Fonts are hosted by the site.')}</p></div>
    <div class="ds-type-sheet"><div><span class="mono">SPACE GROTESK / 400 · 500 · 600</span><div class="ds-type-display">{p('Inteligência para impacto.','Intelligence for impact.')}</div><p class="ds-type-alphabet">Aa Bb Cc Dd Ee Ff Gg · 0123456789 · á ê ã ç</p></div><div><span class="mono">JETBRAINS MONO / 400</span><p class="ds-type-mono">{p('PESQUISA APLICADA. IMPACTO REAL.','APPLIED RESEARCH. REAL IMPACT.')}<br/>NLP / OCR / MCP · 01 — 04</p></div></div>
    <div class="ds-type-rows">{[[p('Título principal','Main heading'),'42–62 px / 500 / 1.08','ds-sample-display',p('Dados que orientam.','Data that guides.')],[p('Título de seção','Section heading'),'40 px / 500 / 1.18','ds-sample-section',p('Ciência na base.','Science at the foundation.')],[p('Título de card','Card heading'),'29 px / 500 / 1.23','ds-sample-card',p('Pesquisa aplicada','Applied research')],[p('Texto de leitura','Reading copy'),'16–18 px / 400 / 1.75–1.85','ds-sample-body',p('Conectamos bases públicas e conhecimento local para orientar decisões.','We connect public datasets and local knowledge to guide decisions.')],[p('Metadados','Metadata'),'9–11 px / 400 / 1.7','mono',p('01 / ÁREAS DE ATUAÇÃO','01 / EXPERTISE')]].map(([label,spec,style,sample])=><div class="ds-type-row"><div><strong>{label}</strong><code>{spec}</code></div><p class={style}>{sample}</p></div>)}</div>
    <p class="ds-note">{p('Os tamanhos se adaptam ao contexto e ao viewport. O título da landing chega a 50 px em tablet e 42 px em mobile; seções chegam a 33 px. Todos os textos acompanham a preferência de leitura até 130%. Metadados pequenos não substituem explicações de leitura.','Sizes adapt to context and viewport. The landing heading uses 50 px on tablet and 42 px on mobile; section headings reach 33 px. All text follows reading preferences up to 130%. Small metadata does not replace readable explanations.')}</p>
   </section>

   <section id="layout" class="ds-section" aria-labelledby="layout-title"><div class="ds-section-heading"><span class="eyebrow">04 / {p('COMPOSIÇÃO','COMPOSITION')}</span><h2 id="layout-title">{p('Respiro é parte da informação.','Space is part of the information.')}</h2><p>{p('Container de até 1.180 px, navegação lateral de 248 px e grids que se reorganizam sem cortar conteúdo.','A container up to 1,180 px, a 248 px sidebar and grids that reorganize without clipping content.')}</p></div>
    <div class="ds-space-scale">{tokens.spacing.map(value=><div><span class="ds-space-bar" style={`width:${value}px`} aria-hidden="true"></span><code>{value} px</code></div>)}</div>
    <div class="ds-two"><div class="ds-panel"><h3>{p('Estrutura da página','Page structure')}</h3><div class="ds-layout-demo" aria-hidden="true"><div></div><div><i></i><i></i><i></i><i></i></div></div><p>{p('Margens laterais: 40 px no desktop, 32 px em tablet e 20 px em mobile. Seções: 92 px de respiro vertical, reduzidos para 65 px em mobile.','Side gutters: 40 px on desktop, 32 px on tablet and 20 px on mobile. Sections: 92 px of vertical space, reduced to 65 px on mobile.')}</p></div><div class="ds-panel"><h3>{p('Pontos de adaptação','Adaptation points')}</h3><dl class="ds-specs"><div><dt>1.100 px</dt><dd>{p('Lateral vira menu móvel','Sidebar becomes a mobile menu')}</dd></div><div><dt>900 px</dt><dd>{p('Hero e conteúdo editorial empilham','Hero and editorial content stack')}</dd></div><div><dt>800 px</dt><dd>{p('Modais passam para uma coluna','Dialogs switch to one column')}</dd></div><div><dt>650 / 600 px</dt><dd>{p('Cards, formulários e espaços compactos','Compact cards, forms and spacing')}</dd></div><div><dt>480 px</dt><dd>{p('Ajustes finos de modal e stack','Fine adjustments to dialogs and stack')}</dd></div></dl></div></div>
    <p class="ds-note">{p('A escala é uma referência de composição; componentes existentes também usam intervalos intermediários quando necessário. Conteúdo, zoom e tradução devem determinar a quebra de linha.','The scale is a composition reference; existing components also use intermediate values when needed. Content, zoom and translation should determine line wrapping.')}</p>
   </section>

   <section id="formas" class="ds-section" aria-labelledby="shapes-title"><div class="ds-section-heading"><span class="eyebrow">05 / {p('FORMAS','SHAPES')}</span><h2 id="shapes-title">{p('Superfícies leves. Detalhes intencionais.','Light surfaces. Intentional details.')}</h2><p>{p('Bordas finas, cantos suaves e sombras discretas mantêm o foco no conteúdo. Filetes coral–azul conectam os dois acentos da identidade.','Thin borders, soft corners and subtle shadows keep attention on content. Coral-to-blue rules connect the two identity accents.')}</p></div>
    <div class="ds-radius-grid">{Object.entries(tokens.radii).map(([name,value])=><div><div class="ds-radius-example" style={`border-radius:${value}px`} aria-hidden="true"></div><code>{name} / {value} px</code></div>)}</div>
    <div class="ds-panel"><div class="ds-gradient-demo" aria-hidden="true"></div><p>{p('Filete editorial: 1 px. Destaques de painéis e modais: 3 px. Gradiente horizontal do coral #FD5638 ao azul #0057FF.','Editorial rule: 1 px. Panel and dialog accents: 3 px. Horizontal gradient from coral #FD5638 to blue #0057FF.')}</p><code>linear-gradient(90deg, #fd5638, #0057ff)</code></div>
    <div class="ds-three ds-surface-examples"><div class="ds-panel"><h3>{p('Leitura','Reading')}</h3><p>{p('Branco, borda neutra e pouco ruído.','White, neutral borders and little visual noise.')}</p></div><div class="ds-panel ds-blue"><h3>{p('Contexto técnico','Technical context')}</h3><p>{p('Azul suave para dados e informações de apoio.','Soft blue for data and supporting information.')}</p></div><div class="ds-panel ds-dark"><h3>{p('Destaque','Highlight')}</h3><p>{p('Carvão com texto claro e acentos luminosos.','Charcoal with light text and bright accents.')}</p></div></div>
   </section>

   <section id="botoes" class="ds-section" aria-labelledby="buttons-title"><div class="ds-section-heading"><span class="eyebrow">06 / {p('AÇÕES','ACTIONS')}</span><h2 id="buttons-title">{p('Ações claras, em todos os estados.','Clear actions, in every state.')}</h2><p>{p('Use coral claro para o convite principal e azul para ações de método e dados. Links de texto atendem ações complementares.','Use light coral for the primary invitation and blue for method and data actions. Text links serve supporting actions.')}</p></div>
    <div class="ds-panel ds-actions"><a class="button" href={`${home(lang)}#contato`}>{p('Vamos conversar','Let’s talk')}<Fragment set:html={arrow}/></a><a class="button button-blue" href={`${home(lang)}#metodologia`}>{p('Nosso método','Our approach')}<Fragment set:html={northeast}/></a><a class="text-link" href={`${home(lang)}#atuacao`}>{p('Explorar atuação','Explore expertise')}<Fragment set:html={northeast}/></a><a class="button button-small" href={link('publications',lang)}>{p('Publicações','Publications')}<Fragment set:html={arrow}/></a></div>
    <div class="ds-state-grid"><div><a class="button" href="#botoes">{p('Padrão','Default')}</a><span class="mono">DEFAULT / #FF896B</span></div><div><a class="button ds-demo-hover" href="#botoes">{p('Ao passar','Hover')}</a><span class="mono">HOVER / #FF9C82</span></div><div><a class="button ds-demo-focus" href="#botoes">{p('Foco visível','Visible focus')}</a><span class="mono">FOCUS / 2 PX + 5 PX</span></div><div><button class="button" disabled>{p('Indisponível','Unavailable')}</button><span class="mono">DISABLED</span></div></div>
    <p class="ds-note">{p('Os estados hover e foco acima são amostras visuais; todos os links funcionam. Use Tab para observar o foco real. O botão indisponível é desativado nativamente. Botão padrão: mínimo de 52 px de altura; compacto: 44 px.','Hover and focus above are visual samples; every link works. Use Tab to observe real focus. The unavailable button is natively disabled. Standard button: at least 52 px high; compact button: 44 px.')}</p>
   </section>

   <section id="componentes" class="ds-section" aria-labelledby="components-title"><div class="ds-section-heading"><span class="eyebrow">07 / {p('CONTEÚDO','CONTENT')}</span><h2 id="components-title">{p('Um sistema de componentes editoriais.','A system of editorial components.')}</h2><p>{p('Cards de atuação apresentam uma proposta, um contexto e uma ação. Tags resumem temas; códigos ajudam a orientar a leitura técnica.','Expertise cards present a proposition, context and action. Tags summarize topics; codes help orient technical reading.')}</p></div>
    <div class="services-grid ds-service-examples">{getServices(lang).map((s,i)=><article class="service-card"><div class="service-top"><span class="service-icon" set:html={icon(s.icon)}/><div class="service-index"><span>{String(i+1).padStart(2,'0')}</span>{s.code}</div></div><h3>{s.name}</h3><p>{s.description}</p><div class="tags">{s.tags.map(tag=><span>{tag}</span>)}</div><a class="text-link service-more" href={`${home(lang)}#atuacao`}>{p('Ver na página inicial','View on the homepage')}<Fragment set:html={northeast}/></a></article>)}</div>
    <div class="ds-two"><div class="ds-panel"><div class="eyebrow"><span class="status-dot"></span>{p('PUBLICAÇÃO DE PESQUISA','RESEARCH PUBLICATION')}</div><h3>{p('Publicações e whitepapers','Publications and whitepapers')}</h3><p>{p('Título, resumo, autores, data e temas conduzem ao artigo. O template inclui sumário, métodos, fontes, limitações e citação.','Title, abstract, authors, date and topics lead to the article. The template includes contents, methods, sources, limitations and citation.')}</p><a class="text-link" href={link('template',lang)}>{p('Abrir template editorial','Open editorial template')}<Fragment set:html={northeast}/></a></div><div class="ds-panel"><div class="eyebrow">{p('METADADOS E TAGS','METADATA AND TAGS')}</div><h3>{p('Informação em camadas','Layered information')}</h3><div class="tags"><span>OCR</span><span>MCP</span><span>{p('Microdados','Microdata')}</span></div><p>{p('Tags são rótulos de conteúdo. Use controles com estado e semântica próprios quando a interação for filtrar ou selecionar.','Tags are content labels. Use controls with their own state and semantics when the interaction filters or selects.')}</p></div></div>
    <div class="ds-panel" style="margin-top:24px"><h3>{p('Biblioteca e preparação editorial','Library and editorial preparation')}</h3><p>{p('A biblioteca combina busca textual, temas, ano e formato. Cards de destaque usam uma linha fina coral–azul. Exemplos fictícios levam um selo explícito; séries sintéticas têm legenda. O editor usa etapas numeradas, campos rotulados, validação e um arquivo para revisão.','The library combines text search, topics, year and format. Featured cards use a thin coral-to-blue rule. Fictional examples carry an explicit badge; synthetic series have captions. The editor uses numbered steps, labeled fields, validation and a file for review.')}</p><div class="ds-actions"><a class="text-link" href={link('publications',lang)}>{p('Explorar biblioteca','Explore the library')}<Fragment set:html={northeast}/></a><a class="text-link" href={link('editor',lang)}>{p('Abrir editor','Open the editor')}<Fragment set:html={northeast}/></a></div></div>
   </section>

   <section id="formularios" class="ds-section" aria-labelledby="forms-title"><div class="ds-section-heading"><span class="eyebrow">08 / {p('ENTRADA E RETORNO','INPUT AND FEEDBACK')}</span><h2 id="forms-title">{p('Orientação antes da ação.','Guidance before action.')}</h2><p>{p('Campos com rótulos visíveis, instruções próximas e mensagens claras. Os exemplos abaixo são locais e não enviam nem armazenam dados.','Fields with visible labels, nearby instructions and clear messages. The examples below are local and neither send nor store data.')}</p></div>
    <div class="ds-two"><div class="ds-panel ds-fields"><label for="ds-name">{p('Nome do projeto','Project name')}<input id="ds-name" type="text" placeholder={p('Ex.: Indicadores de educação','E.g. Education indicators')} autocomplete="off" aria-describedby="ds-name-help"/></label><p id="ds-name-help" class="ds-field-help">{p('Exemplo editável de campo padrão.','Editable example of a standard field.')}</p><label for="ds-interest">{p('Área de interesse','Area of interest')}<select id="ds-interest"><option>{p('Pesquisa aplicada','Applied research')}</option><option>{p('Engenharia de dados','Data engineering')}</option><option>{p('Análise territorial','Territorial analysis')}</option></select></label><label for="ds-message">{p('Contexto','Context')}<textarea id="ds-message" placeholder={p('Descreva o desafio…','Describe the challenge…')} aria-describedby="ds-message-help"></textarea></label><p id="ds-message-help" class="ds-field-help">{p('A área de texto pode ser ampliada verticalmente.','The text area can be resized vertically.')}</p></div><div class="ds-panel ds-fields"><label for="ds-invalid">{p('E-mail — exemplo de erro','Email — error example')}<input id="ds-invalid" type="email" value="email-incompleto" aria-invalid="true" aria-describedby="ds-email-error"/></label><p id="ds-email-error" class="ds-field-error">{p('Informe um endereço completo, como nome@organizacao.org.','Enter a complete address, such as name@organization.org.')}</p><label for="ds-disabled">{p('Campo indisponível','Unavailable field')}<input id="ds-disabled" value={p('Exemplo desativado','Disabled example')} disabled/></label><div class="ds-feedback"><Fragment set:html={icon('check')}/><p>{p('Exemplo de confirmação: mensagem preparada. No contato real, o envio é concluído no aplicativo de e-mail.','Confirmation example: message prepared. In the actual contact flow, sending is completed in the email app.')}</p></div><p class="ds-note">{p('O erro é identificado por mensagem e aria-invalid, além da borda. Use aria-describedby para associar ajuda e feedback ao campo.','Errors are identified by a message and aria-invalid, as well as the border. Use aria-describedby to associate help and feedback with the field.')}</p><a class="text-link" href={`${home(lang)}#contato`}>{p('Abrir contato real','Open actual contact')}<Fragment set:html={northeast}/></a></div></div>
   </section>

   <section id="icones" class="ds-section" aria-labelledby="icons-title"><div class="ds-section-heading"><span class="eyebrow">09 / {p('REPRESENTAÇÃO','REPRESENTATION')}</span><h2 id="icons-title">{p('Ícones precisos. Gráficos com contexto.','Precise icons. Contextual graphics.')}</h2><p>{p('SVGs leves, traço de 1,4 em viewBox 24 × 24, pontas arredondadas e cor herdada. Setas usam traço de 1,6.','Lightweight SVGs, 1.4 strokes in a 24 × 24 viewBox, rounded caps and inherited color. Arrows use 1.6 strokes.')}</p></div>
    <div class="ds-icon-grid">{icons.map((name,i)=><div><span class="service-icon" set:html={icon(name)}/><strong>{iconLabels[i]}</strong><code>{name}</code></div>)}</div>
    <div class="ds-two"><figure class="ds-panel ds-graphic"><svg viewBox="0 0 400 170" aria-hidden="true"><g stroke="#dfe1ea" stroke-width="1"><path d="M25 30h350M25 70h350M25 110h350M25 150h350"/></g><path d="M25 125 85 100 145 112 210 65 285 78 375 30" fill="none" stroke="#0057ff" stroke-width="2"/><path d="M25 140 85 128 145 90 210 110 285 52 375 65" fill="none" stroke="#fd5638" stroke-width="2"/><g fill="#0057ff"><circle cx="210" cy="65" r="4"/><circle cx="375" cy="30" r="4"/></g></svg><figcaption>{p('Ilustração de linguagem gráfica — sem dados reais.','Graphic-language illustration — no actual data.')}</figcaption></figure><div class="ds-panel"><h3>{p('Publicar gráficos e mapas','Publishing charts and maps')}</h3><ul class="ds-list"><li>{p('Informar fonte, período, unidade e metodologia.','Include source, timeframe, unit and methodology.')}</li><li>{p('Oferecer resumo textual ou tabela com os dados.','Provide a textual summary or data table.')}</li><li>{p('Diferenciar séries também por rótulo, padrão ou forma.','Differentiate series with labels, patterns or shapes too.')}</li><li>{p('Proteger coordenadas e atributos sensíveis.','Protect sensitive coordinates and attributes.')}</li></ul></div></div>
    <p class="ds-note">{p('Ícones decorativos usam aria-hidden. Controles com ícone precisam de nome acessível. Em fundos escuros, use acentos claros como #FFB5A5; em superfícies claras, o azul oferece definição.','Decorative icons use aria-hidden. Icon controls need an accessible name. Use light accents such as #FFB5A5 on dark backgrounds; blue offers definition on light surfaces.')}</p>
   </section>

   <section id="interacao" class="ds-section" aria-labelledby="interaction-title"><div class="ds-section-heading"><span class="eyebrow">10 / {p('COMPORTAMENTO','BEHAVIOR')}</span><h2 id="interaction-title">{p('Orientação constante, movimento discreto.','Constant orientation, subtle movement.')}</h2><p>{p('A navegação acompanha a leitura; animações dão retorno breve. Todas as ações essenciais podem ser realizadas por teclado.','Navigation accompanies reading; animations give brief feedback. Essential actions can be performed with a keyboard.')}</p></div>
    <div class="ds-two"><div class="ds-panel"><h3>{p('Navegação e rodapé','Navigation and footer')}</h3><ul class="ds-list"><li>{p('Lateral fixa no desktop; drawer em telas até 1.100 px.','Fixed desktop sidebar; drawer on screens up to 1,100 px.')}</li><li>{p('Seção atual indicada com aria-current e fundo azul suave.','Current section indicated with aria-current and a soft blue background.')}</li><li>{p('Menu móvel fecha ao navegar ou pressionar Escape e devolve o foco.','Mobile menu closes on navigation or Escape and restores focus.')}</li><li>{p('Rodapé reúne contato, navegação, empresa, privacidade e acessibilidade.','Footer brings together contact, navigation, company details, privacy and accessibility.')}</li></ul></div><div class="ds-panel"><h3>{p('Modais, abas e expansões','Dialogs, tabs and disclosures')}</h3><ul class="ds-list"><li>{p('Modal de atuação até 1.040 px, rolagem interna e fechamento visível.','Expertise dialog up to 1,040 px, internal scrolling and a visible close control.')}</li><li>{p('Foco inicial no título; Escape fecha e devolve o foco à origem.','Initial focus on the heading; Escape closes and restores focus to the opener.')}</li><li>{p('Abas operam com setas, Home e End.','Tabs support arrows, Home and End.')}</li><li>{p('Details/summary expande termos e referências com comportamento nativo.','Details/summary expands terms and references with native behavior.')}</li></ul><a class="text-link" href={`${home(lang)}#atuacao`}>{p('Experimentar os modais','Try the dialogs')}<Fragment set:html={northeast}/></a></div></div>
    <details class="ds-disclosure"><summary>{p('Experimentar uma expansão','Try a disclosure')}</summary><p>{p('Este componente usa HTML nativo: pode ser aberto com Enter ou Espaço quando o resumo recebe foco.','This component uses native HTML: it can be opened with Enter or Space when the summary has focus.')}</p></details>
    <dl class="ds-specs ds-motion"><div><dt>200 ms</dt><dd>{p('Botões e links','Buttons and links')}</dd></div><div><dt>250 ms</dt><dd>{p('Cards e drawer','Cards and drawer')}</dd></div><div><dt>−2 / −4 px</dt><dd>{p('Elevação de botão / card ao passar','Button / card lift on hover')}</dd></div><div><dt>smooth → auto</dt><dd>{p('Rolagem respeita redução de movimento','Scrolling respects reduced motion')}</dd></div></dl>
   </section>

   <section id="acessibilidade" class="ds-section" aria-labelledby="access-title"><div class="ds-section-heading"><span class="eyebrow">11 / {p('ACESSIBILIDADE','ACCESSIBILITY')}</span><h2 id="access-title">{p('Leitura que se adapta às pessoas.','Reading that adapts to people.')}</h2><p>{p('Semântica, foco visível, contraste e preferências de leitura fazem parte dos componentes. A referência é WCAG 2.1 AA.','Semantics, visible focus, contrast and reading preferences are part of the components. WCAG 2.1 AA is the reference.')}</p></div>
    <div class="ds-panel ds-blue"><div class="ds-actions"><button class="button button-blue" data-open="accessibility-dialog">{p('Experimentar ajustes de leitura','Try reading settings')}<Fragment set:html={arrow}/></button><a class="text-link" href={link('accessibility',lang)}>{p('Ler declaração','Read statement')}<Fragment set:html={northeast}/></a></div><p>{p('Texto de 100% a 130%, alto contraste e redução de movimento. As preferências ficam apenas no dispositivo e podem ser apagadas no rodapé.','Text from 100% to 130%, high contrast and reduced motion. Preferences stay on the device and can be cleared from the footer.')}</p></div>
    <div class="ds-two"><div class="ds-panel"><h3>{p('Critérios de implementação','Implementation criteria')}</h3><ul class="ds-list"><li>{p('HTML com landmarks e títulos em ordem; link para pular ao conteúdo.','HTML landmarks and ordered headings; a skip-to-content link.')}</li><li>{p('Contraste mínimo 4,5:1 no texto normal e 3:1 no texto grande.','Minimum contrast of 4.5:1 for normal text and 3:1 for large text.')}</li><li>{p('Alvos principais de interação com pelo menos 44 px.','Primary interaction targets at least 44 px in size.')}</li><li>{p('Rótulos, instruções e mensagens vinculadas aos campos.','Labels, instructions and messages associated with fields.')}</li></ul></div><div class="ds-panel"><h3>{p('Verificação contínua','Continuous verification')}</h3><ul class="ds-list"><li>{p('Testes automáticos com axe e navegação por teclado.','Automated axe checks and keyboard navigation.')}</li><li>{p('Responsividade, zoom, texto ampliado e preferência de movimento.','Responsiveness, zoom, enlarged text and motion preferences.')}</li><li>{p('Revisão humana de descrição de imagens, gráficos e linguagem.','Human review of image descriptions, charts and language.')}</li><li>{p('Testes com leitores de tela e pessoas com deficiência complementam a automação.','Screen-reader and disabled-user testing complement automation.')}</li></ul></div></div>
   </section>

   <section id="implementacao" class="ds-section" aria-labelledby="implementation-title"><div class="ds-section-heading"><span class="eyebrow">12 / {p('CONTINUIDADE','CONTINUITY')}</span><h2 id="implementation-title">{p('Uma referência para evoluir com consistência.','A reference for consistent evolution.')}</h2><p>{p('O site estático em Astro usa componentes compartilhados, conteúdo bilíngue, SVGs e fontes locais. A documentação acompanha os valores atuais da interface.','The static Astro site uses shared components, bilingual content, SVGs and local fonts. This documentation reflects current interface values.')}</p></div>
    <div class="ds-table-wrap"><table><caption>{p('Onde manter cada parte do sistema','Where to maintain each part of the system')}</caption><thead><tr><th scope="col">{p('Arquivo','File')}</th><th scope="col">{p('Responsabilidade','Responsibility')}</th></tr></thead><tbody>{[['src/style.css',p('Estilos e comportamento dos componentes do site','Site component styles and behavior')],['src/lib/design-system.ts',p('Tokens documentados e cálculo de contraste','Documented tokens and contrast calculation')],['src/components/DesignSystem.astro',p('Esta documentação e seus exemplos','This documentation and its examples')],['src/lib/visuals.ts',p('Ícones e diagramas SVG','SVG icons and diagrams')],['src/components/ServiceDetails.astro',p('Modais de atuação','Expertise dialogs')],['src/layouts/Base.astro',p('Fontes, SEO e estrutura compartilhada','Fonts, SEO and shared structure')],['src/research-library.css',p('Biblioteca, filtros, cards de pesquisa e editor','Library, filters, research cards and editor')],['src/components/ResearchLibrary.astro',p('Catálogo público e dados de busca','Public catalog and search data')],['src/components/PublicationEditor.astro',p('Preparação local de publicações em Markdown','Local preparation of Markdown publications')],['src/content/publications/',p('Publicações Markdown PT/EN','PT/EN Markdown publications')],['tests/smoke.mjs',p('Regressões visuais, funcionais e de acessibilidade','Visual, functional and accessibility regressions')]].map(([file,note])=><tr><th scope="row"><code>{file}</code></th><td>{note}</td></tr>)}</tbody></table></div>
    <div class="ds-two"><div class="ds-panel"><h3>{p('Ao criar um componente','When creating a component')}</h3><ol class="ds-list"><li>{p('Reutilize tokens, padrões e semântica existentes.','Reuse existing tokens, patterns and semantics.')}</li><li>{p('Defina conteúdo, estados, teclado e adaptação móvel.','Define content, states, keyboard behavior and mobile adaptation.')}</li><li>{p('Revise português, inglês e conteúdo acessível.','Review Portuguese, English and accessible content.')}</li><li>{p('Valide, documente e publique após os testes.','Validate, document and publish after tests.')}</li></ol></div><div class="ds-panel"><h3>{p('Recursos para construir','Resources for building')}</h3><p>{p('O arquivo JSON exporta cores, tipografia, espaços, raios, layout e comportamento. Ao mudar valores no CSS, atualize os tokens, os exemplos e os testes correspondentes.','The JSON file exports colors, typography, spacing, radii, layout and behavior. When CSS values change, update the tokens, examples and corresponding tests.')}</p><a class="text-link" href={path('design-tokens.json').replace(/\/$/,'')} download="serra-design-tokens.json">{p('Baixar referência de tokens','Download token reference')}<Fragment set:html={arrow}/></a><a class="text-link" href={link('template',lang)}>{p('Abrir template de publicação','Open publication template')}<Fragment set:html={northeast}/></a></div></div>
   </section>
  </div>
