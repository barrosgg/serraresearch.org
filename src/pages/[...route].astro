---
import Base from '../layouts/Base.astro';
import Publications from '../components/Publications.astro';
import {documents} from '../lib/legal';
import {routes,link,home} from '../lib/site';
import {pick,type Locale} from '../i18n';
export function getStaticPaths(){return (['pt','en'] as Locale[]).flatMap(lang=>(['privacy','cookies','accessibility','publications'] as const).map(kind=>({params:{route:routes[kind][lang]},props:{lang,kind}})));}
const {lang,kind}=Astro.props;
const doc=kind==='publications'?null:documents[kind][lang];
const title=doc?.title||pick(lang,'Publicações e whitepapers','Publications and whitepapers');
const description=doc?.description||pick(lang,'Biblioteca de pesquisa da Serra Research: whitepapers, relatórios e notas técnicas.','Serra Research research library: whitepapers, reports and technical notes.');
---
<Base lang={lang} title={`${title} — Serra Research`} description={description} alternate={link(kind,lang==='pt'?'en':'pt')}>
 <main id="conteudo" tabindex="-1" class="document-main">
  {doc?<article class="container document"><a class="text-link" href={home(lang)}>← {pick(lang,'Página inicial','Home')}</a><div class="eyebrow">SERRA / {pick(lang,'TRANSPARÊNCIA','TRANSPARENCY')}</div><h1>{doc.title}</h1><p class="document-intro">{doc.intro}</p><p class="document-date">{pick(lang,'Atualizada em 10 de outubro de 2026','Updated October 10, 2026')}</p><nav class="document-toc" aria-label={pick(lang,'Nesta página','On this page')}><strong>{pick(lang,'Nesta página','On this page')}</strong>{doc.sections.map((s,i)=><a href={`#item-${i}`}>{s.title}</a>)}</nav>{doc.sections.map((s,i)=><section id={`item-${i}`} aria-labelledby={`title-${i}`}><h2 id={`title-${i}`}>{s.title}</h2>{s.paragraphs.map(text=><p>{text}</p>)}{s.items&&<ul>{s.items.map(text=><li>{text}</li>)}</ul>}</section>)}<p class="document-contact"><a href="mailto:oi@serraresearch.org">oi@serraresearch.org ↗</a></p></article>:<><div class="container"><a class="text-link" href={home(lang)}>← {pick(lang,'Página inicial','Home')}</a><h1 class="library-title">{title}</h1></div><Publications lang={lang} section={false}/></>}
 </main>
</Base>
